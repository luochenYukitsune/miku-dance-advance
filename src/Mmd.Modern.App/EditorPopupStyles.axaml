<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Mmd.Modern.App"
        xmlns:converters="using:Avalonia.Controls.Converters">
  <!-- SukiUI 5.3.0 includes SimpleTheme and gives ThemeBackgroundBrush a fixed light
       value. Its MenuFlyoutPresenter and ToolTip therefore need the same explicit
       palette as the editor text. Keep the existing templates and popup behavior. -->
  <Styles.Resources>
    <ResourceDictionary>
      <converters:PlatformKeyGestureConverter x:Key="EditorMenuGestureConverter" />
      <FontFamily x:Key="EditorFont">avares://Mmd.Modern.App/Assets/Fonts#HarmonyOS Sans SC</FontFamily>
      <!-- Output* dialogs use the same palette. These fallbacks allow them to share
           the popup styles; EditorWindow's own resources remain authoritative. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="EditorSurface" Color="#0D1116" />
          <SolidColorBrush x:Key="EditorPanelSurface" Color="#151B22" />
          <SolidColorBrush x:Key="EditorText" Color="#EEF1F4" />
          <SolidColorBrush x:Key="EditorMuted" Color="#9DA7B4" />
          <SolidColorBrush x:Key="EditorDisabledText" Color="#636C77" />
          <SolidColorBrush x:Key="EditorBorder" Color="#28313D" />
          <SolidColorBrush x:Key="EditorSelection" Color="#3DD68C" />
          <SolidColorBrush x:Key="EditorInputSurface" Color="#11161D" />
          <SolidColorBrush x:Key="EditorHover" Color="#222B36" />
          <SolidColorBrush x:Key="EditorSelectedSurface" Color="#17342A" /><SolidColorBrush x:Key="MdaAccent" Color="#2BB673" /><SolidColorBrush x:Key="MdaAccentText" Color="#06140C" /><SolidColorBrush x:Key="MdaAccentHover" Color="#35C77F" /><SolidColorBrush x:Key="MdaAccentSoft" Color="#4CE298" /><SolidColorBrush x:Key="MdaAccentDisabled" Color="#1B2129" /><Color x:Key="SukiPrimaryColor">#2BB673</Color><SolidColorBrush x:Key="MdaDanger" Color="#C2453A" /><SolidColorBrush x:Key="MdaDangerHover" Color="#C94B40" /><SolidColorBrush x:Key="MdaButton" Color="#202833" /><SolidColorBrush x:Key="MdaButtonBorder" Color="#313C4A" /><SolidColorBrush x:Key="MdaButtonHover" Color="#2A3442" /><SolidColorBrush x:Key="MdaButtonPressed" Color="#333F50" /><SolidColorBrush x:Key="MdaButtonDisabled" Color="#181E25" /><SolidColorBrush x:Key="EditorDisabledTextShared" Color="#636C77" /></ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="EditorSurface" Color="#EBEEF2" />
          <SolidColorBrush x:Key="EditorPanelSurface" Color="#FAFBFC" />
          <SolidColorBrush x:Key="EditorText" Color="#1A1F24" />
          <SolidColorBrush x:Key="EditorMuted" Color="#59636E" />
          <SolidColorBrush x:Key="EditorDisabledText" Color="#96A0AA" />
          <SolidColorBrush x:Key="EditorBorder" Color="#D2DAE3" />
          <SolidColorBrush x:Key="EditorSelection" Color="#12844A" />
          <SolidColorBrush x:Key="EditorInputSurface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="EditorHover" Color="#E7ECF2" />
          <SolidColorBrush x:Key="EditorSelectedSurface" Color="#DCF2E6" /><SolidColorBrush x:Key="MdaAccent" Color="#12844A" /><SolidColorBrush x:Key="MdaAccentText" Color="#FFFFFF" /><SolidColorBrush x:Key="MdaAccentHover" Color="#0F7340" /><SolidColorBrush x:Key="MdaAccentSoft" Color="#0E6E3D" /><SolidColorBrush x:Key="MdaAccentDisabled" Color="#EEF1F4" /><Color x:Key="SukiPrimaryColor">#12844A</Color><SolidColorBrush x:Key="MdaDanger" Color="#B3382E" /><SolidColorBrush x:Key="MdaDangerHover" Color="#9C2F26" /><SolidColorBrush x:Key="MdaButton" Color="#FFFFFF" /><SolidColorBrush x:Key="MdaButtonBorder" Color="#CBD3DD" /><SolidColorBrush x:Key="MdaButtonHover" Color="#EFF3F7" /><SolidColorBrush x:Key="MdaButtonPressed" Color="#E3E9F0" /><SolidColorBrush x:Key="MdaButtonDisabled" Color="#EFF2F5" /><SolidColorBrush x:Key="EditorDisabledTextShared" Color="#96A0AA" /></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- One CheckBox for every window. The SukiUI 5.3.0 box takes its fill from fixed translucent
       resources, so an unchecked box disappears on both palettes. Same named parts as Simple. -->
  <Style Selector="CheckBox">
    <Setter Property="Background" Value="{DynamicResource MdaButton}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MdaButtonBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="Transparent">
          <Border Name="CheckBoxBox" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center"
                  Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Panel>
              <Path Name="CheckMark" Data="M 3.5 9 L 7.5 13 L 14.5 5" Stroke="{DynamicResource MdaAccentText}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round" IsVisible="False" />
              <Rectangle Name="IndeterminateMark" Width="8" Height="2" Fill="{DynamicResource MdaAccentText}" IsVisible="False" />
            </Panel>
          </Border>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox:pointerover /template/ Border#CheckBoxBox"><Setter Property="BorderBrush" Value="{DynamicResource MdaAccentSoft}" /></Style>
  <Style Selector="CheckBox:checked /template/ Border#CheckBoxBox, CheckBox:indeterminate /template/ Border#CheckBoxBox">
    <Setter Property="Background" Value="{DynamicResource MdaAccent}" /><Setter Property="BorderBrush" Value="{DynamicResource MdaAccent}" /></Style>
  <Style Selector="CheckBox:checked /template/ Path#CheckMark"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="CheckBox:indeterminate /template/ Rectangle#IndeterminateMark"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="CheckBox:disabled /template/ Border#CheckBoxBox"><Setter Property="Opacity" Value="0.45" /></Style>
  <Style Selector="CheckBox:disabled"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" /></Style>
  <!-- A window-wide TextBlock foreground would otherwise keep a disabled label at full contrast. -->
  <Style Selector="CheckBox:disabled TextBlock, RadioButton:disabled TextBlock, Button:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
  <Style Selector="CheckBox:focus-visible /template/ Border#CheckBoxBox"><Setter Property="BorderBrush" Value="{DynamicResource MdaAccentSoft}" /></Style>

  <!-- One horizontal slider for every window (EditorValueSlider and the light sliders). A 4 px track with
       an accent fill and a 14 px thumb, inside a 24 px hit area so it is easy to grab; the whole track
       is clickable. The SukiUI 5.3.0 slider is thinner and uses its own primary colour. -->
  <Style Selector="Slider:horizontal">
    <Setter Property="MinHeight" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource MdaAccent}" /><Setter Property="Background" Value="{DynamicResource MdaButtonBorder}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Track Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Focusable="False" Background="Transparent">
                <RepeatButton.Template><ControlTemplate>
                  <Border Background="Transparent"><Border Name="SliderFill" Height="4" CornerRadius="2,0,0,2" VerticalAlignment="Center" Background="{DynamicResource MdaAccent}" /></Border>
                </ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Focusable="False" Background="Transparent">
                <RepeatButton.Template><ControlTemplate>
                  <Border Background="Transparent"><Border Name="SliderRest" Height="4" CornerRadius="0,2,2,0" VerticalAlignment="Center" Background="{DynamicResource MdaButtonBorder}" /></Border>
                </ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Thumb Name="SliderThumb" Width="14" Height="14">
              <Thumb.Template><ControlTemplate>
                <Border Name="ThumbKnob" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource EditorPanelSurface}"
                        BorderBrush="{DynamicResource MdaAccent}" BorderThickness="3" />
              </ControlTemplate></Thumb.Template>
            </Thumb>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Slider:horizontal:pointerover /template/ Thumb#SliderThumb"><Setter Property="RenderTransform" Value="scale(1.15)" /></Style>
  <Style Selector="Slider:horizontal:focus-visible /template/ Thumb#SliderThumb"><Setter Property="RenderTransform" Value="scale(1.15)" /></Style>
  <Style Selector="Slider:disabled"><Setter Property="Opacity" Value="0.4" /><Setter Property="Cursor" Value="Arrow" /></Style>
  <Style Selector="Slider:empty /template/ Thumb#SliderThumb"><Setter Property="IsVisible" Value="False" /></Style>

  <Style Selector="MenuFlyoutPresenter, ContextMenu, ToolTip">
    <Setter Property="Background" Value="{DynamicResource EditorPanelSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBorder}" />
    <Setter Property="FontFamily" Value="{DynamicResource EditorFont}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <!-- Suki 5.3 offsets context rows by -20 DIPs and animates submenus to a fixed width.
       Measure each localized header and gesture inside the actual popup instead. -->
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="MinWidth" Value="144" />
    <Setter Property="WindowManagerAddShadowHint" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                            Grid.IsSharedSizeScope="True" KeyboardNavigation.TabNavigation="Continue" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ContextMenu MenuItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorMenuMarker" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorMenuGesture" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="EditorMenuArrow" />
              </Grid.ColumnDefinitions>
              <Panel Name="marker" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                <ContentPresenter Content="{TemplateBinding Icon}" />
                <Path Name="EditorMenuCheck" IsVisible="{TemplateBinding IsChecked}" Data="M1,7 L5,11 L13,2"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" />
              </Panel>
              <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" VerticalAlignment="Center"
                    Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                    RecognizesAccessKey="True" Foreground="{TemplateBinding Foreground}" />
              <TextBlock Name="PART_InputGestureText" Grid.Column="2" VerticalAlignment="Center"
                    IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Text="{TemplateBinding InputGesture, Converter={StaticResource EditorMenuGestureConverter}}" />
              <Path Name="EditorMenuChevron" Grid.Column="3" Margin="8,0,1,0" VerticalAlignment="Center"
                    Data="M1,1 L5,5 L1,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" />
            </Grid>
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}" IsLightDismissEnabled="False"
                   Placement="RightEdgeAlignedTop" WindowManagerAddShadowHint="True">
              <Border Background="{DynamicResource EditorPanelSurface}" BorderBrush="{DynamicResource EditorBorder}"
                      BorderThickness="1" CornerRadius="7" Padding="3" MinWidth="144">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Name="PART_ItemsPresenter" Grid.IsSharedSizeScope="True" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ContextMenu MenuItem[ToggleType=CheckBox] /template/ Panel#marker, ContextMenu MenuItem[ToggleType=Radio] /template/ Panel#marker">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ContextMenu MenuItem:empty /template/ Path#EditorMenuChevron">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ContextMenu MenuItem:focus-visible /template/ Border#root">
    <Setter Property="BorderBrush" Value="{DynamicResource EditorSelection}" />
  </Style>
  <Style Selector="ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource EditorBorder}" />
    <Setter Property="Margin" Value="6,3" />
    <Setter Property="Height" Value="1" />
  </Style>
  <Style Selector="ContextMenu MenuItem /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Margin" Value="16,0,4,0" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Foreground" Value="{DynamicResource EditorMuted}" />
  </Style>
  <Style Selector="ContextMenu MenuItem:disabled /template/ TextBlock#PART_InputGestureText">
    <Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" />
  </Style>
  <Style Selector="ToolTip TextBlock, ToolTip AccessText">
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="local:EditorMotion.Feedback" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
  </Style>
  <Style Selector="MenuItem /template/ Border#root">
    <Setter Property="local:EditorMotion.Feedback" Value="True" />
  </Style>
  <Style Selector="MenuItem TextBlock, MenuItem AccessText">
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource EditorHover}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource EditorSelectedSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBorder}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="MenuItem:selected:pointerover /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource EditorHover}" />
  </Style>
  <!-- Suki's submenu border and glyphs have template-priority resource values.
       Use the real :open/:disabled state so these overrides outrank the template. -->
  <Style Selector="MenuItem:open /template/ Popup#PART_Popup > Border">
    <Setter Property="Background" Value="{DynamicResource EditorPanelSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBorder}" />
  </Style>
  <Style Selector="MenuItem:not(:empty) /template/ Path#rightArrow, MenuItem:checked /template/ Path#check">
    <Setter Property="Fill" Value="{DynamicResource EditorText}" />
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="MenuItem:disabled TextBlock, MenuItem:disabled AccessText">
    <Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" />
  </Style>
  <Style Selector="MenuItem:disabled /template/ Path#rightArrow, MenuItem:disabled /template/ Path#check">
    <Setter Property="Fill" Value="{DynamicResource EditorDisabledText}" />
  </Style>

  <!-- The code-created recovery picker shares the editor palette and the quiet
       row selection rather than inheriting Fluent's bright accent surface. -->
  <Style Selector="ListBox.recoveryCopies">
    <Setter Property="Background" Value="{DynamicResource EditorPanelSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.recoveryCopies ListBoxItem">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template"><ControlTemplate>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch" />
      </Border>
    </ControlTemplate></Setter>
  </Style>
  <Style Selector="ListBox.recoveryCopies ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource EditorHover}" /></Style>
  <Style Selector="ListBox.recoveryCopies ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource EditorSelectedSurface}" /></Style>
  <Style Selector="ListBox.recoveryCopies ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource EditorSelection}" /></Style>
  <Style Selector="Button.recoveryAction">
    <Setter Property="Background" Value="{DynamicResource EditorInputSurface}" /><Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5" /><Setter Property="CornerRadius" Value="4" />
    <Setter Property="Template"><ControlTemplate>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </ControlTemplate></Setter>
  </Style>
  <Style Selector="Button.recoveryAction:pointerover"><Setter Property="Background" Value="{DynamicResource EditorHover}" /></Style>
  <Style Selector="Button.recoveryAction:pressed"><Setter Property="Background" Value="{DynamicResource EditorSelectedSurface}" /></Style>
  <Style Selector="Button.recoveryAction:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource EditorSelection}" /></Style>
  <Style Selector="Button.recoveryAction:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" /></Style>
</Styles>
