<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mmd.Modern.App"
             xmlns:validated="using:Mmd.Modern.App.Controls"
             x:Class="Mmd.Modern.App.EditorLightInspector"
             x:DataType="local:EditorLightingViewModel">
  <StackPanel Spacing="8">
    <ComboBox Name="LightChoice" ItemsSource="{Binding Lights}" SelectedItem="{Binding SelectedLight, Mode=OneWay}" SelectionChanged="SelectLegacyLight"
              HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Mda.Text.58da4654116f}">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorNativeLightItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Name="EmptyLightPrompt" Text="{DynamicResource Mda.Text.d6bf33235c3e}" Classes="caption" TextWrapping="Wrap" />
    <StackPanel Name="ModernLightSelectionTools" IsVisible="{Binding IsModernWorkspace}" Spacing="8">
    <ContentControl Name="LightGroupProperties" Content="{Binding SelectedGroup}" IsVisible="{Binding HasSelectedGroup}" HorizontalContentAlignment="Stretch">
      <ContentControl.ContentTemplate><DataTemplate x:DataType="local:EditorLightGroupItem">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding NameLabel}" Classes="group" />
          <TextBox Name="LightGroupNameInput" Classes="editorSearch" Text="{Binding Name, Mode=TwoWay}" LostFocus="CommitInput" AutomationProperties.Name="{Binding NameLabel}" />
          <CheckBox Tag="enabled" Content="{DynamicResource Mda.Text.0d6601d54d15}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="CommitToggle" />
          <Grid ColumnDefinitions="*,8,96">
            <TextBlock Text="{Binding IntensityLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <validated:EditorNumericUpDown Name="LightGroupIntensityInput" Grid.Column="2" Classes="editorNumber" Value="{Binding Intensity, Mode=TwoWay}" Increment="0.1" FormatString="0.###" LostFocus="CommitInput" AutomationProperties.Name="{Binding IntensityLabel}" />
          </Grid>
          <validated:EditorLightParameterSlider Name="LightGroupBrightnessSlider" Minimum="0" Maximum="8" SmallChange="0.02" LargeChange="0.2" Value="{Binding BrightnessSliderPosition, Mode=OneWay}"
              EditStarted="BeginGroupParameterEdit" EditPreview="PreviewGroupParameterEdit" EditCompleted="CompleteGroupParameterEdit" EditCanceled="CancelGroupParameterEdit"
              AutomationProperties.Name="{Binding IntensityLabel}" />
        </StackPanel>
      </DataTemplate></ContentControl.ContentTemplate>
    </ContentControl>
    <StackPanel IsVisible="{Binding HasSelection}" Spacing="6">
      <TextBlock Text="{Binding SelectionSummary}" Classes="group" IsVisible="{Binding ShowBatchControls}" />
      <WrapPanel Orientation="Horizontal" Margin="0,0,0,-4">
        <Button Name="DuplicateSelectedLightsButton" Classes="action" Content="{Binding DuplicateSelectionLabel}" Click="DuplicateLights"
                Height="NaN" MinHeight="28" Padding="10,4" Margin="0,0,6,4" />
        <Button Name="GroupSelectedLightsButton" Classes="action" Content="{Binding GroupSelectionLabel}" Click="GroupLights" IsEnabled="{Binding CanGroupSelection}"
                Height="NaN" MinHeight="28" Padding="10,4" Margin="0,0,6,4" />
        <Button Classes="action" Content="{Binding DissolveSelectionLabel}" Click="DissolveLightGroups" IsVisible="{Binding CanDissolveSelection}"
                Height="NaN" MinHeight="28" Padding="10,4" Margin="0,0,6,4" />
      </WrapPanel>
      <StackPanel IsVisible="{Binding ShowBatchControls}" Spacing="6">
        <StackPanel Spacing="2" IsVisible="{Binding HasSelectedLight}">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBlock Text="{Binding RelativeBrightnessLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Column="2" Text="{Binding RelativeBrightnessSummary}" Classes="caption" VerticalAlignment="Center" />
          </Grid>
          <validated:EditorLightParameterSlider Name="BatchLightBrightnessSlider" Minimum="-2" Maximum="2" SmallChange="0.02" LargeChange="0.2" Value="{Binding RelativeBrightnessPosition, Mode=OneWay}"
              EditStarted="BeginGroupParameterEdit" EditPreview="PreviewGroupParameterEdit" EditCompleted="CompleteGroupParameterEdit" EditCanceled="CancelGroupParameterEdit"
              AutomationProperties.Name="{Binding RelativeBrightnessLabel}" />
        </StackPanel>
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,-4">
          <Button Classes="action" Content="{Binding EnableSelectionLabel}" Click="EnableLights"
                  Height="NaN" MinHeight="28" Padding="10,4" Margin="0,0,6,4" />
          <Button Classes="action" Content="{Binding DisableSelectionLabel}" Click="DisableLights"
                  Height="NaN" MinHeight="28" Padding="10,4" Margin="0,0,6,4" />
        </WrapPanel>
        <Expander Name="BatchLightAbsoluteExpander" Header="{Binding BatchIntensityLabel}" Classes="editorAdvanced" IsVisible="{Binding HasSelectedLight}" IsExpanded="False" HorizontalContentAlignment="Stretch">
        <Grid ColumnDefinitions="*,6,80,6,Auto">
          <TextBlock Text="{Binding BatchIntensityLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <validated:EditorNumericUpDown Name="BatchLightIntensityInput" Grid.Column="2" Classes="editorNumber" Value="{Binding BatchIntensity, Mode=TwoWay}" Increment="0.1" FormatString="0.###" AutomationProperties.Name="{Binding BatchIntensityLabel}" />
          <Button Grid.Column="4" Classes="action" Content="{Binding ApplyIntensityLabel}" Click="SetBatchIntensity" Height="NaN" MinHeight="28" Padding="10,4" />
        </Grid>
        </Expander>
      </StackPanel>
    </StackPanel>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding InspectorLights}">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:EditorNativeLightItem">
        <StackPanel Spacing="6" IsVisible="{Binding IsInspectorVisible}">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{DynamicResource Mda.Text.7cb9050d7b72}" Classes="group" VerticalAlignment="Center" />
              <CheckBox Grid.Column="1" Tag="enabled" Content="{DynamicResource Mda.Text.0d6601d54d15}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="CommitToggle" MinHeight="24" />
            </Grid>
            <TextBox Name="LightNameInput" Classes="editorSearch" Text="{Binding Name, Mode=TwoWay}" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.7cb9050d7b72}" />
            <ComboBox Name="InlineLightKind" ItemsSource="{Binding KindChoices}" SelectedIndex="{Binding KindIndex, Mode=OneWay}"
                      SelectionChanged="CommitLightKind" IsVisible="{Binding UseModernControls}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{DynamicResource Mda.Text.0a10a5398b8a}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorLightKindChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="4">
            <Border Classes="parameterHeader"><TextBlock Text="{Binding ColorLabel}" Classes="group" /></Border>
            <Grid ColumnDefinitions="36,8,*">
              <Border Name="LightColorSwatch" Width="36" Height="26" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" CornerRadius="4" />
              <TextBox Grid.Column="2" Name="LightHexColor" Classes="editorSearch" LostFocus="CommitHexColor" AutomationProperties.Name="{DynamicResource Mda.Text.2582a5c98b76}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Width="24" Height="24" Padding="3" Tag="#FFFFFF" Click="ChooseColor" ToolTip.Tip="{DynamicResource Mda.Text.f56e7eff58bf}" AutomationProperties.Name="{DynamicResource Mda.Text.f56e7eff58bf}"><Border Width="16" Height="16" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" CornerRadius="2" Background="#FFFFFF" /></Button>
              <Button Width="24" Height="24" Padding="3" Tag="#FFE7C7" Click="ChooseColor" ToolTip.Tip="{DynamicResource Mda.Text.966c66b331ea}" AutomationProperties.Name="{DynamicResource Mda.Text.966c66b331ea}"><Border Width="16" Height="16" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" CornerRadius="2" Background="#FFE7C7" /></Button>
              <Button Width="24" Height="24" Padding="3" Tag="#FFBD78" Click="ChooseColor" ToolTip.Tip="{DynamicResource Mda.Text.b5159bb8082c}" AutomationProperties.Name="{DynamicResource Mda.Text.b5159bb8082c}"><Border Width="16" Height="16" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" CornerRadius="2" Background="#FFBD78" /></Button>
              <Button Width="24" Height="24" Padding="3" Tag="#CDE5FF" Click="ChooseColor" ToolTip.Tip="{DynamicResource Mda.Text.0ef411a8a875}" AutomationProperties.Name="{DynamicResource Mda.Text.0ef411a8a875}"><Border Width="16" Height="16" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" CornerRadius="2" Background="#CDE5FF" /></Button>
              <Button Width="24" Height="24" Padding="3" Tag="#82B5FF" Click="ChooseColor" ToolTip.Tip="{DynamicResource Mda.Text.67035e6b7f82}" AutomationProperties.Name="{DynamicResource Mda.Text.67035e6b7f82}"><Border Width="16" Height="16" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" CornerRadius="2" Background="#82B5FF" /></Button>
              <Button Width="24" Height="24" Padding="3" Tag="#FFC7DB" Click="ChooseColor" ToolTip.Tip="{DynamicResource Mda.Text.dbd379b39f0d}" AutomationProperties.Name="{DynamicResource Mda.Text.dbd379b39f0d}"><Border Width="16" Height="16" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" CornerRadius="2" Background="#FFC7DB" /></Button>
              <Button Width="24" Height="24" Padding="3" Tag="#D6C7FF" Click="ChooseColor" ToolTip.Tip="{DynamicResource Mda.Text.2ed9c6fabac2}" AutomationProperties.Name="{DynamicResource Mda.Text.2ed9c6fabac2}"><Border Width="16" Height="16" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" CornerRadius="2" Background="#D6C7FF" /></Button>
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,8,96">
              <TextBlock Text="{Binding BrightnessLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <validated:EditorNumericUpDown Name="InlineLightIntensity" Grid.Column="2" Classes="editorNumber" Value="{Binding Intensity, Mode=TwoWay}" Minimum="0" Increment="0.05" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.c56114268030}" />
            </Grid>
            <validated:EditorLightParameterSlider Name="LightBrightnessSlider" Tag="brightness" IsVisible="{Binding UseModernControls}"
                Minimum="0" Maximum="{Binding BrightnessSliderMaximum}" SmallChange="0.02" LargeChange="0.2" Value="{Binding BrightnessSliderPosition, Mode=OneWay}"
                EditStarted="BeginParameterEdit" EditPreview="PreviewParameterEdit" EditCompleted="CompleteParameterEdit" EditCanceled="CancelParameterEdit"
                AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Brightness}" />
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding UseModernControls}">
            <WrapPanel Orientation="Horizontal">
              <CheckBox Tag="shadows" Margin="0,0,10,2" Content="{DynamicResource Mda.Text.eddb92cad478}" IsChecked="{Binding CastShadows, Mode=TwoWay}" Click="CommitToggle" MinHeight="24" />
              <Button Name="ResetLightBrightnessButton" Classes="action" IsVisible="{Binding UseModernControls}"
                      Content="{DynamicResource Mda.Text.Context.Lighting.ResetBrightness}" Click="ResetLightBrightness"
                      Height="24" MinHeight="24" Padding="8,0" FontSize="12" Margin="0,0,0,2" />
            </WrapPanel>
            <StackPanel Spacing="2" IsVisible="{Binding HasRange}">
              <Grid ColumnDefinitions="*,8,96">
                <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.Distance}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <validated:EditorNumericUpDown Name="InlineLightRangeDirect" Grid.Column="2" Classes="editorNumber" Value="{Binding Range, Mode=TwoWay}" Increment="0.5" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Distance}" />
              </Grid>
              <validated:EditorLightParameterSlider Name="LightDistanceSlider" Tag="distance" Minimum="-2" Maximum="5" SmallChange="0.02" LargeChange="0.2" Value="{Binding DistanceSliderPosition, Mode=OneWay}"
                  EditStarted="BeginParameterEdit" EditPreview="PreviewParameterEdit" EditCompleted="CompleteParameterEdit" EditCanceled="CancelParameterEdit"
                  AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Distance}" />
            </StackPanel>
            <StackPanel Name="AreaLightDimensions" Spacing="6" IsVisible="{Binding HasAreaSize}">
              <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.AreaDimensions}" Classes="group" />
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,8,96">
                  <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.AreaWidth}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <validated:EditorNumericUpDown Name="InlineLightAreaWidth" Grid.Column="2" Classes="editorNumber" Value="{Binding AreaWidth, Mode=TwoWay}" Increment="0.1" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.AreaWidth}" />
                </Grid>
                <validated:EditorLightParameterSlider Name="LightAreaWidthSlider" Tag="areaWidth" Minimum="-2" Maximum="4" SmallChange="0.02" LargeChange="0.2" Value="{Binding AreaWidthSliderPosition, Mode=OneWay}"
                    EditStarted="BeginParameterEdit" EditPreview="PreviewParameterEdit" EditCompleted="CompleteParameterEdit" EditCanceled="CancelParameterEdit"
                    AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.AreaWidth}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,8,96">
                  <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.AreaHeight}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <validated:EditorNumericUpDown Name="InlineLightAreaHeight" Grid.Column="2" Classes="editorNumber" Value="{Binding AreaHeight, Mode=TwoWay}" Increment="0.1" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.AreaHeight}" />
                </Grid>
                <validated:EditorLightParameterSlider Name="LightAreaHeightSlider" Tag="areaHeight" Minimum="-2" Maximum="4" SmallChange="0.02" LargeChange="0.2" Value="{Binding AreaHeightSliderPosition, Mode=OneWay}"
                    EditStarted="BeginParameterEdit" EditPreview="PreviewParameterEdit" EditCompleted="CompleteParameterEdit" EditCanceled="CancelParameterEdit"
                    AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.AreaHeight}" />
              </StackPanel>
              <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.AreaHint}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding HasCone}">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,8,96">
                  <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.BeamWidth}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <validated:EditorNumericUpDown Name="InlineLightBeamWidth" Grid.Column="2" Classes="editorNumber" Value="{Binding BeamWidthDegrees, Mode=TwoWay}" Increment="1" FormatString="0.##" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.BeamWidth}" />
                </Grid>
                <validated:EditorLightParameterSlider Name="LightBeamWidthSlider" Tag="width" Minimum="1" Maximum="180" SmallChange="1" LargeChange="10" Value="{Binding BeamWidthDegrees, Mode=OneWay}"
                    EditStarted="BeginParameterEdit" EditPreview="PreviewParameterEdit" EditCompleted="CompleteParameterEdit" EditCanceled="CancelParameterEdit"
                    AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.BeamWidth}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,8,96">
                  <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.EdgeSoftness}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <validated:EditorNumericUpDown Name="InlineLightEdgeSoftness" Grid.Column="2" Classes="editorNumber" Value="{Binding EdgeSoftnessPercent, Mode=TwoWay}" Increment="1" FormatString="0.##" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" ToolTip.Tip="{DynamicResource Mda.Text.Context.Lighting.SoftnessHint}" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.EdgeSoftness}" />
                </Grid>
                <validated:EditorLightParameterSlider Name="LightEdgeSoftnessSlider" Tag="softness" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding EdgeSoftnessPercent, Mode=OneWay}"
                    EditStarted="BeginParameterEdit" EditPreview="PreviewParameterEdit" EditCompleted="CompleteParameterEdit" EditCanceled="CancelParameterEdit"
                    ToolTip.Tip="{DynamicResource Mda.Text.Context.Lighting.SoftnessHint}" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.EdgeSoftness}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Expander Name="LightTransformExpander" IsExpanded="{Binding $parent[local:EditorLightInspector].TransformExpanded, Mode=TwoWay}" Classes="editorAdvanced" Header="{DynamicResource Mda.Text.Layout.Transform}" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="6">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Mda.Text.1fb4d574da92}" Classes="group" />
                <Grid ColumnDefinitions="*,6,*,6,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="X" Classes="axis" /><TextBlock Grid.Column="2" Text="Y" Classes="axis" /><TextBlock Grid.Column="4" Text="Z" Classes="axis" />
                  <validated:EditorNumericUpDown Name="InlineLightPositionX" Grid.Row="1" Classes="editorNumber" Value="{Binding PositionX, Mode=TwoWay}" Increment="0.1" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.c794c85eb233}" />
                  <validated:EditorNumericUpDown Name="InlineLightPositionY" Grid.Row="1" Grid.Column="2" Classes="editorNumber" Value="{Binding PositionY, Mode=TwoWay}" Increment="0.1" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.d231a265df1d}" />
                  <validated:EditorNumericUpDown Name="InlineLightPositionZ" Grid.Row="1" Grid.Column="4" Classes="editorNumber" Value="{Binding PositionZ, Mode=TwoWay}" Increment="0.1" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.47f6738046c7}" />
                </Grid>
                <TextBlock IsVisible="{Binding IsDirectional}" Text="{DynamicResource Mda.Text.Context.Lighting.DirectionalPositionHint}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="6" IsVisible="{Binding HasDirection}">
                <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.DirectionSection}" Classes="group" />
                <Button Name="LightAimMenu" Classes="action" Content="{DynamicResource Mda.Text.Layout.Aim}" HorizontalAlignment="Left">
                  <Button.Flyout><MenuFlyout>
                    <MenuItem Name="InlineLightAimCenterButton" Header="{DynamicResource Mda.Text.Context.Lighting.AimAtCenter}" Click="AimLightAtCenter" />
                    <MenuItem Name="InlineLightAimCameraButton" Header="{DynamicResource Mda.Text.Context.Lighting.AimFromCamera}" Click="AimLightFromCamera" />
                    <MenuItem Name="InlineLightFlipHemisphereButton" Header="{Binding HemisphereLabel}" Click="FlipLightHemisphere" />
                  </MenuFlyout></Button.Flyout>
                </Button>
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.TargetHeading}" Classes="caption" />
                  <Grid ColumnDefinitions="*,6,*,6,*" RowDefinitions="Auto,Auto">
                    <TextBlock Text="X" Classes="axis" /><TextBlock Grid.Column="2" Text="Y" Classes="axis" /><TextBlock Grid.Column="4" Text="Z" Classes="axis" />
                    <validated:EditorNumericUpDown Name="InlineLightTargetX" Grid.Row="1" Classes="editorNumber" Value="{Binding TargetX, Mode=TwoWay}" Increment="0.1" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.TargetX}" />
                    <validated:EditorNumericUpDown Name="InlineLightTargetY" Grid.Row="1" Grid.Column="2" Classes="editorNumber" Value="{Binding TargetY, Mode=TwoWay}" Increment="0.1" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.TargetY}" />
                    <validated:EditorNumericUpDown Name="InlineLightTargetZ" Grid.Row="1" Grid.Column="4" Classes="editorNumber" Value="{Binding TargetZ, Mode=TwoWay}" Increment="0.1" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.TargetZ}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Expander>
          <Expander Name="InlineLightAdvanced" Classes="editorAdvanced" Header="{DynamicResource Mda.Text.d6e61888b078}" IsExpanded="{Binding $parent[local:EditorLightInspector].AdvancedExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
              <CheckBox Tag="shadows" Content="{DynamicResource Mda.Text.eddb92cad478}" IsVisible="{Binding UseLegacyControls}" IsChecked="{Binding CastShadows, Mode=TwoWay}" Click="CommitToggle" />
              <StackPanel IsVisible="{Binding UseLegacyControls}"><Grid ColumnDefinitions="*,8,96" IsVisible="{Binding HasRange}">
                <TextBlock Text="{DynamicResource Mda.Text.3a76ebfb6233}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <validated:EditorNumericUpDown Name="InlineLightRange" Grid.Column="2" Classes="editorNumber" Value="{Binding Range, Mode=TwoWay}" Increment="0.5" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.0999a174c82d}" />
              </Grid></StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding HasCone}">
                <TextBlock Text="{DynamicResource Mda.Text.3466d127a0db}" Classes="group" />
                <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="{DynamicResource Mda.Text.aab9919ac9dc}" Classes="caption" Margin="1,0,0,4" TextWrapping="Wrap" /><TextBlock Grid.Column="2" Text="{DynamicResource Mda.Text.08ba4adfa930}" Classes="caption" Margin="1,0,0,4" TextWrapping="Wrap" />
                  <validated:EditorNumericUpDown Name="InlineLightInnerCone" Grid.Row="1" Classes="editorNumber" Value="{Binding InnerConeDegrees, Mode=TwoWay}" Increment="1" FormatString="0.##" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.473225888625}" />
                  <validated:EditorNumericUpDown Name="InlineLightOuterCone" Grid.Row="1" Grid.Column="2" Classes="editorNumber" Value="{Binding OuterConeDegrees, Mode=TwoWay}" Increment="1" FormatString="0.##" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.bf2c5326647a}" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding HasDirection}">
                <TextBlock Text="{DynamicResource Mda.Text.bab4c7dc2948}" Classes="group" />
                <Grid ColumnDefinitions="*,6,*,6,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="X" Classes="axis" /><TextBlock Grid.Column="2" Text="Y" Classes="axis" /><TextBlock Grid.Column="4" Text="Z" Classes="axis" />
                  <validated:EditorNumericUpDown Name="InlineLightRotationX" Grid.Row="1" Classes="editorNumber" Value="{Binding RotationX, Mode=TwoWay}" Increment="1" FormatString="0.##" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.fc879178fcc2}" />
                  <validated:EditorNumericUpDown Name="InlineLightRotationY" Grid.Row="1" Grid.Column="2" Classes="editorNumber" Value="{Binding RotationY, Mode=TwoWay}" Increment="1" FormatString="0.##" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.e4bf72774482}" />
                  <validated:EditorNumericUpDown Name="InlineLightRotationZ" Grid.Row="1" Grid.Column="4" Classes="editorNumber" Value="{Binding RotationZ, Mode=TwoWay}" Increment="1" FormatString="0.##" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.69ba1a47f9f4}" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Mda.Text.10c74b677a3f}" Classes="group" />
                <Grid ColumnDefinitions="*,6,*,6,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="R" Classes="axis" /><TextBlock Grid.Column="2" Text="G" Classes="axis" /><TextBlock Grid.Column="4" Text="B" Classes="axis" />
                  <validated:EditorNumericUpDown Name="InlineLightRed" Grid.Row="1" Classes="editorNumber" Value="{Binding Red, Mode=TwoWay}" Minimum="0" Increment="0.05" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.8a05eccbaa40}" />
                  <validated:EditorNumericUpDown Name="InlineLightGreen" Grid.Row="1" Grid.Column="2" Classes="editorNumber" Value="{Binding Green, Mode=TwoWay}" Minimum="0" Increment="0.05" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.5afec3ccb732}" />
                  <validated:EditorNumericUpDown Name="InlineLightBlue" Grid.Row="1" Grid.Column="4" Classes="editorNumber" Value="{Binding Blue, Mode=TwoWay}" Minimum="0" Increment="0.05" FormatString="0.###" ValueChanged="PreviewNumericInput" LostFocus="CommitInput" AutomationProperties.Name="{DynamicResource Mda.Text.32c648ad3cf5}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Expander Name="LightLinkExpander" Classes="editorAdvanced" Header="{DynamicResource Mda.Text.Layout.Links}"
              IsVisible="{Binding ShowSingleLight}" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="8">
        <StackPanel Name="LightParentProperties" Spacing="6" IsVisible="False">
          <StackPanel Spacing="6">
          <StackPanel Spacing="3">
            <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.ParentModel}" Classes="caption" />
            <ComboBox Name="LightParentModelChoice" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="False"
                      SelectionChanged="SelectLightParentModel" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.ParentModel}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorLightParentModelChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="3">
            <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.ParentBone}" Classes="caption" />
            <ComboBox Name="LightParentBoneChoice" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="False"
                      SelectionChanged="SelectLightParentBone" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.ParentBone}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorLightParentBoneChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.ParentHint}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <StackPanel Name="LightReceiverProperties" IsVisible="False">
            <StackPanel Spacing="6">
              <ComboBox Name="LightReceiverMode" HorizontalAlignment="Stretch" SelectionChanged="SelectLightReceiverMode" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.ReceiversHeading}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorLightReceiverModeChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Name="LightReceiverSelection" Spacing="6" IsVisible="False">
                <TextBox Name="LightReceiverSearch" Classes="editorSearch" Watermark="{DynamicResource Mda.Text.Context.Lighting.ReceiversSearch}" TextChanged="SearchLightReceivers" />
                <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl Name="LightReceiverModels">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:EditorLightReceiverChoice">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="SelectLightReceiver" MinHeight="28" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Name="LightReceiverCount" Classes="caption" />
              </StackPanel>
              <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.ReceiversHint}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
      </StackPanel>
    </Expander>
    <Expander Name="LightPresetExpander" Header="{DynamicResource Mda.Text.Context.Lighting.Presets.Heading}"
              IsVisible="{Binding IsModernWorkspace}" IsExpanded="False" Classes="editorAdvanced" HorizontalContentAlignment="Stretch">
      <StackPanel Name="LightPresetTools" Spacing="6">
        <WrapPanel Name="TrackLightPresetTools" IsVisible="False">
          <Button Classes="action" Margin="0,0,4,4" Content="{DynamicResource Mda.Text.Layout.ApplyLight}" Click="ApplyTrackPreset" />
          <Button Classes="action" Margin="0,0,4,4" Content="{DynamicResource Mda.Text.Layout.SaveLight}" Click="SaveTrackPreset" />
        </WrapPanel>
        <WrapPanel IsVisible="{Binding ShowSingleLight}">
          <Button Name="ApplyCurrentLightPresetButton" Classes="action" Margin="0,0,4,4" Content="{DynamicResource Mda.Text.Layout.ApplyLight}" Click="ApplySingleLightPreset" />
          <Button Name="SaveCurrentLightPresetButton" Classes="action" Margin="0,0,4,4" Content="{DynamicResource Mda.Text.Layout.SaveLight}" Click="SaveSingleLightPreset" />
        </WrapPanel>
        <StackPanel IsVisible="{Binding ShowBatchControls}" Spacing="6">
          <ComboBox Name="LightPresetChoice" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    SelectionChanged="SelectLightPreset" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Presets.Heading}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorLightPresetChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <WrapPanel Margin="0,0,0,-4">
            <Button Name="ReplaceLightPresetButton" Classes="action" Content="{DynamicResource Mda.Text.Context.Lighting.Presets.ReplaceSelected}" Click="ReplaceLightPreset" IsEnabled="{Binding HasSelection}"
                    Height="NaN" MinHeight="28" Padding="10,4" Margin="0,0,6,4" />
          </WrapPanel>
          <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.Presets.Name}" Classes="caption" />
          <TextBox Name="LightPresetName" Classes="editorSearch" MaxLength="200" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Presets.Name}" />
          <WrapPanel Margin="0,0,0,-4">
            <Button Name="LoadLightPresetButton" Classes="action" Content="{DynamicResource Mda.Text.Context.Lighting.Presets.Load}" Click="LoadLightPreset"
                    Height="NaN" MinHeight="28" Padding="10,4" Margin="0,0,6,4" />
            <Button Name="SaveLightPresetButton" Classes="action" Content="{DynamicResource Mda.Text.Context.Lighting.Presets.SaveSelected}" Click="SaveLightPreset" IsEnabled="{Binding HasSelectedLight}"
                    Height="NaN" MinHeight="28" Padding="10,4" Margin="0,0,6,4" />
          </WrapPanel>
          <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.Presets.PortableHint}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Expander>
    <Expander Name="GlobalEnvironmentExpander" Header="{DynamicResource Mda.Text.Context.Lighting.Global.EnvironmentHeading}"
              IsVisible="{Binding IsModernWorkspace}" IsExpanded="False" Classes="editorAdvanced" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.Global.EnvironmentHint}" Classes="caption" TextWrapping="Wrap" />
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,8,88">
            <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.Global.EnvironmentStrength}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <validated:EditorNumericUpDown Name="GlobalEnvironmentInput" Grid.Column="2" Classes="editorNumber" Value="{Binding EnvironmentStrength, Mode=TwoWay}"
                Minimum="0" Maximum="4" Increment="0.05" FormatString="0.###" LostFocus="CommitGlobalInput"
                AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Global.EnvironmentStrength}" />
          </Grid>
          <validated:EditorLightParameterSlider Name="GlobalEnvironmentSlider" Tag="environment" Minimum="0" Maximum="4" SmallChange="0.05" LargeChange="0.5" Value="{Binding EnvironmentStrength, Mode=OneWay}"
              EditStarted="BeginGlobalParameterEdit" EditPreview="PreviewGlobalParameterEdit" EditCompleted="CompleteGlobalParameterEdit" EditCanceled="CancelGlobalParameterEdit"
              AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Global.EnvironmentStrength}" />
        </StackPanel>
        <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.Global.GiHint}" Classes="caption" TextWrapping="Wrap" />
        <Button Name="GlobalPreviewQualityButton" Classes="action" Content="{DynamicResource Mda.Text.Context.Lighting.Global.PreviewQuality}" Click="OpenGlobalPreviewQuality"
                Height="NaN" MinHeight="28" Padding="10,4" HorizontalAlignment="Left" />
      </StackPanel>
    </Expander>
    <Expander Name="GlobalExposureExpander" Header="{DynamicResource Mda.Text.Context.Lighting.Global.ExposureHeading}"
              IsVisible="{Binding IsModernWorkspace}" IsExpanded="False" Classes="editorAdvanced" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="6">
        <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.Global.ExposureHint}" Classes="caption" TextWrapping="Wrap" />
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,8,88">
            <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.Global.ExposureEv}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <validated:EditorNumericUpDown Name="GlobalExposureInput" Grid.Column="2" Classes="editorNumber" Value="{Binding ExposureEv, Mode=TwoWay}"
                Minimum="-8" Maximum="8" Increment="0.1" FormatString="0.###" LostFocus="CommitGlobalInput"
                AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Global.ExposureEv}" />
          </Grid>
          <validated:EditorLightParameterSlider Name="GlobalExposureSlider" Tag="exposure" Minimum="-8" Maximum="8" SmallChange="0.1" LargeChange="1" Value="{Binding ExposureEv, Mode=OneWay}"
              EditStarted="BeginGlobalParameterEdit" EditPreview="PreviewGlobalParameterEdit" EditCompleted="CompleteGlobalParameterEdit" EditCanceled="CancelGlobalParameterEdit"
              AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Global.ExposureEv}" />
        </StackPanel>
      </StackPanel>
    </Expander>
    <TextBlock Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" Classes="caption" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{DynamicResource Mda.Text.20a423f97da8}" Classes="caption" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
