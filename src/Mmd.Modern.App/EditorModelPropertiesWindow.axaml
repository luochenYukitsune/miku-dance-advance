<Window xmlns:validated="using:Mmd.Modern.App.Controls" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Mmd.Modern.App"
        x:Class="Mmd.Modern.App.EditorModelPropertiesWindow" x:DataType="local:EditorModelPropertiesViewModel"
        Title="{DynamicResource Mda.Text.45cde8004799}" Width="960" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OutputSurface}" Foreground="{DynamicResource OutputText}"
        FontFamily="avares://Mmd.Modern.App/Assets/Fonts#HarmonyOS Sans SC" FontSize="14"
        UseLayoutRounding="True" RenderOptions.TextRenderingMode="Antialias">
  <!-- Shared visual contracts copied from the verified native OutputSettingsWindow. -->
  <Window.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="OutputFont">avares://Mmd.Modern.App/Assets/Fonts#HarmonyOS Sans SC</FontFamily>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="OutputSurface" Color="#0F1216" /><SolidColorBrush x:Key="OutputText" Color="#ECEFF2" />
          <SolidColorBrush x:Key="OutputMuted" Color="#A4ACB6" /><SolidColorBrush x:Key="OutputDisabled" Color="#69717B" />
          <SolidColorBrush x:Key="OutputBorder" Color="#2B333D" /><SolidColorBrush x:Key="OutputFocus" Color="#3DD68C" />
          <SolidColorBrush x:Key="OutputHover" Color="#222A34" /><SolidColorBrush x:Key="OutputSelected" Color="#19302A" />
          <SolidColorBrush x:Key="OutputInput" Color="#1B2129" /><SolidColorBrush x:Key="MdaAccent" Color="#2BB673" /><SolidColorBrush x:Key="MdaAccentText" Color="#06140C" /><SolidColorBrush x:Key="MdaAccentHover" Color="#35C77F" /><SolidColorBrush x:Key="MdaAccentSoft" Color="#3DD68C" /><SolidColorBrush x:Key="MdaAccentDisabled" Color="#1B2129" /><Color x:Key="SukiPrimaryColor">#2BB673</Color><SolidColorBrush x:Key="MdaButton" Color="#1F262F" /><SolidColorBrush x:Key="MdaButtonBorder" Color="#323C48" /><SolidColorBrush x:Key="MdaButtonHover" Color="#2A333E" /><SolidColorBrush x:Key="MdaButtonPressed" Color="#34404D" /><SolidColorBrush x:Key="MdaButtonDisabled" Color="#171C22" /><SolidColorBrush x:Key="EditorDisabledTextShared" Color="#69717B" /></ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="OutputSurface" Color="#F6F7F9" /><SolidColorBrush x:Key="OutputText" Color="#1A1D21" />
          <SolidColorBrush x:Key="OutputMuted" Color="#5B636E" /><SolidColorBrush x:Key="OutputDisabled" Color="#9AA1AA" />
          <SolidColorBrush x:Key="OutputBorder" Color="#D9DEE5" /><SolidColorBrush x:Key="OutputFocus" Color="#12844A" />
          <SolidColorBrush x:Key="OutputHover" Color="#E9EDF2" /><SolidColorBrush x:Key="OutputSelected" Color="#DFF2E7" />
          <SolidColorBrush x:Key="OutputInput" Color="#EEF1F4" /><SolidColorBrush x:Key="MdaAccent" Color="#12844A" /><SolidColorBrush x:Key="MdaAccentText" Color="#FFFFFF" /><SolidColorBrush x:Key="MdaAccentHover" Color="#0F7340" /><SolidColorBrush x:Key="MdaAccentSoft" Color="#12844A" /><SolidColorBrush x:Key="MdaAccentDisabled" Color="#EEF1F4" /><Color x:Key="SukiPrimaryColor">#12844A</Color><SolidColorBrush x:Key="MdaButton" Color="#F7F8FA" /><SolidColorBrush x:Key="MdaButtonBorder" Color="#CDD4DC" /><SolidColorBrush x:Key="MdaButtonHover" Color="#EEF1F4" /><SolidColorBrush x:Key="MdaButtonPressed" Color="#E3E8EE" /><SolidColorBrush x:Key="MdaButtonDisabled" Color="#EEF0F3" /><SolidColorBrush x:Key="EditorDisabledTextShared" Color="#9AA1AA" /></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://SukiUI/Theme/Index.xaml" />
    <Style Selector="Control"><Setter Property="UseLayoutRounding" Value="True" /></Style>
    <Style Selector="TemplatedControl"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource OutputText}" /></Style>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" /><Setter Property="Foreground" Value="{DynamicResource OutputText}" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="AccessText"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LineHeight" Value="22" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" /></Style>
    <Style Selector="Button">
      <Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="{DynamicResource OutputSurface}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.action"><Setter Property="Background" Value="{DynamicResource OutputInput}" /></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource OutputSelected}" /></Style>
    <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource OutputBorder}" /><Setter Property="Background" Value="{DynamicResource OutputInput}" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="SelectionBrush" Value="{DynamicResource OutputSelected}" /><Setter Property="CaretBrush" Value="{DynamicResource OutputText}" />
      <!-- Avalonia 11.3.22 Simple TextBox named parts, with no extra Suki 5.3.0 outer inset. -->
      <Setter Property="Template"><ControlTemplate>
        <Border Name="OutputInputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <DockPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <TextBlock Name="floatingWatermark" DockPanel.Dock="Top" Text="{TemplateBinding Watermark}" Foreground="{DynamicResource OutputMuted}">
              <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="UseFloatingWatermark" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
              </MultiBinding></TextBlock.IsVisible>
            </TextBlock>
            <DataValidationErrors>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter Content="{TemplateBinding InnerLeftContent}" />
                <ScrollViewer Name="PART_ScrollViewer" Grid.Column="1" AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                              BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}">
                  <Panel>
                    <TextBlock Name="watermark" Text="{TemplateBinding Watermark}" Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                               TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                      <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                        <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                      </MultiBinding></TextBlock.IsVisible>
                    </TextBlock>
                    <TextPresenter Name="PART_TextPresenter" CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                   CaretBrush="{TemplateBinding CaretBrush}" CaretIndex="{TemplateBinding CaretIndex}"
                                   LineHeight="{TemplateBinding LineHeight}" LetterSpacing="{TemplateBinding LetterSpacing}"
                                   PasswordChar="{TemplateBinding PasswordChar}" RevealPassword="{TemplateBinding RevealPassword}"
                                   SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                   SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}"
                                   Text="{TemplateBinding Text, Mode=TwoWay}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" />
                  </Panel>
                </ScrollViewer>
                <ContentPresenter Grid.Column="2" Content="{TemplateBinding InnerRightContent}" />
              </Grid>
            </DataValidationErrors>
          </DockPanel>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="TextBox:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource OutputInput}" /><Setter Property="BorderBrush" Value="{DynamicResource OutputBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="ShowButtonSpinner" Value="False" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><ControlTemplate><ButtonSpinner Name="PART_Spinner" AllowSpin="{TemplateBinding AllowSpin}" ShowButtonSpinner="False" HorizontalContentAlignment="Stretch" Padding="0"><ButtonSpinner.Template><ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" /></ControlTemplate></ButtonSpinner.Template><TextBox Name="PART_TextBox" Text="{TemplateBinding Text}" Watermark="{TemplateBinding Watermark}" IsReadOnly="{TemplateBinding IsReadOnly}" TextAlignment="{TemplateBinding TextAlignment}"
        FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" /></ButtonSpinner></ControlTemplate></Setter>
    </Style>
    <Style Selector="NumericUpDown:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="NumericUpDown:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="NumericUpDown:disabled /template/ TextBox"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource OutputInput}" /><Setter Property="BorderBrush" Value="{DynamicResource OutputBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="PlaceholderForeground" Value="{DynamicResource OutputMuted}" />
      <!-- Preserve Avalonia 11.3.22 ComboBox selection, popup and editable named parts without the Suki outer inset. -->
      <Setter Property="Template"><ControlTemplate>
        <Border Name="OutputComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="*,24">
            <TextBlock Name="PlaceholderTextBlock" Margin="{TemplateBinding Padding}" Foreground="{TemplateBinding PlaceholderForeground}"
                       Text="{TemplateBinding PlaceholderText}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
              </MultiBinding></TextBlock.IsVisible>
            </TextBlock>
            <ContentControl Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
            <TextBox Name="PART_EditableTextBox" Height="NaN" MinHeight="0" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                     Background="Transparent" BorderThickness="0" Text="{TemplateBinding Text, Mode=TwoWay}" IsVisible="{TemplateBinding IsEditable}" />
            <ToggleButton Name="toggle" Grid.Column="1" Width="24" MinWidth="0" MinHeight="0" Margin="0" Padding="0"
                          Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                          IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate><Border Background="{TemplateBinding Background}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></ToggleButton.Template>
              <Path Width="8" Height="4" Stretch="Uniform" Fill="{DynamicResource OutputMuted}"
                    Data="F1 M 301.14,-189.041L 311.57,-189.041L 306.355,-182.942L 301.14,-189.041 Z" />
            </ToggleButton>
            <Popup Name="PART_Popup" MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}" IsLightDismissEnabled="True"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{TemplateBinding}" InheritsTransform="True">
              <Border Background="{DynamicResource OutputSurface}" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="1"
                      RenderOptions.TextRenderingMode="Antialias" UseLayoutRounding="True">
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}" IsScrollChainingEnabled="False">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="ComboBox:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="ComboBox:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="ComboBox /template/ ContentPresenter"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="ComboBoxItem"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="10,6" /><Setter Property="MinHeight" Value="30" /><Setter Property="Background" Value="{DynamicResource OutputSurface}" /><Setter Property="Foreground" Value="{DynamicResource OutputText}" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" RenderOptions.TextRenderingMode="Antialias" UseLayoutRounding="True"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="ComboBoxItem:selected"><Setter Property="Background" Value="{DynamicResource OutputSelected}" /></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource OutputText}" /></Style>
    <Style Selector="CheckBox /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OutputText}" /></Style>
    <Style Selector="CheckBox:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="TabControl"><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="{DynamicResource OutputSurface}" /></Style>
    <Style Selector="TabItem">
      <Setter Property="Height" Value="38" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="20,0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" />
      <Setter Property="Template"><ControlTemplate><Border Name="OutputTabSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource OutputText}" /><Setter Property="Background" Value="{DynamicResource OutputSelected}" /></Style>
    <Style Selector="TabItem:selected /template/ Border#OutputTabSurface"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="TabItem:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="Expander.outputAdvanced:down">
      <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="ContentTransition" Value="{x:Null}" />
      <!-- Avalonia Simple's down-expander contract, kept flat and without a decorative container. -->
      <Setter Property="Template"><ControlTemplate><Grid RowDefinitions="Auto,Auto">
        <ToggleButton Name="PART_toggle" Classes="advanced" Content="{TemplateBinding Header}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
        <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" Margin="0,12,0,0" Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"
                          Foreground="{TemplateBinding Foreground}" IsVisible="{TemplateBinding IsExpanded}" Opacity="1" />
      </Grid></ControlTemplate></Setter>
    </Style>
    <Style Selector="ToggleButton.advanced">
      <Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid ColumnDefinitions="24,*"><Path Width="5" Height="8" Data="M 0 0 L 4 4 L 0 8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        </Grid>
      </Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ToggleButton.advanced:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="ToggleButton.advanced:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="ToggleButton.advanced:checked /template/ Path"><Setter Property="RenderTransform"><RotateTransform Angle="90" /></Setter></Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
      </Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource OutputSelected}" /></Style>
    <Style Selector="ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="Separator"><Setter Property="Background" Value="{DynamicResource OutputBorder}" /><Setter Property="Margin" Value="0,4" /></Style>
    <StyleInclude Source="avares://Mmd.Modern.App/EditorPopupStyles.axaml" />
  
    <!-- MDA shared button roles (same in every window):
         default  = input surface + border; .primary = solid brand green; .quiet = flat (cancel/close). -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource MdaButton}" /><Setter Property="BorderBrush" Value="{DynamicResource MdaButtonBorder}" /><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource MdaButtonHover}" /></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource MdaButtonPressed}" /></Style>
    <Style Selector="Button:disabled"><Setter Property="Background" Value="{DynamicResource MdaButtonDisabled}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource MdaAccent}" /><Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.primary /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" /></Style>
    <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="{DynamicResource MdaAccentHover}" /></Style>
    <Style Selector="Button.primary:pressed"><Setter Property="Background" Value="{DynamicResource MdaAccent}" /></Style>
    <Style Selector="Button.primary:disabled"><Setter Property="Background" Value="{DynamicResource MdaButtonDisabled}" /></Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.quiet:pointerover"><Setter Property="Background" Value="{DynamicResource MdaButtonHover}" /></Style>
    <Style Selector="CheckBox:disabled"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource MdaAccentSoft}" /></Style>
    <Style Selector="TabItem:selected /template/ Border"><Setter Property="BorderBrush" Value="{DynamicResource MdaAccentSoft}" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="*,Auto">
    <TabControl Name="ModelPropertiesTabs">
      <TabItem Header="{DynamicResource Mda.Text.c98e118e0a43}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24" Spacing="24">
            <StackPanel Spacing="12">
              <TextBlock Text="{DynamicResource Mda.Text.f98c5746576c}" Classes="section" />
              <Grid ColumnDefinitions="120,*,120"><TextBlock Text="{DynamicResource Mda.Text.0db718df3d49}" Classes="label" /><TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.0db718df3d49}" /></Grid>
              <Grid ColumnDefinitions="120,260,*"><TextBlock Text="{DynamicResource Mda.Text.eb7f45c914b5}" Classes="label" /><ComboBox Grid.Column="1" ItemsSource="{Binding RoleChoices}" SelectedIndex="{Binding RoleIndex, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.eb7f45c914b5}" /></Grid>
              <CheckBox Name="IndoorEnvironment" IsVisible="{Binding IsEnvironment}" Margin="120,0,0,0"
                        IsChecked="{Binding IsIndoorEnvironment, Mode=TwoWay}"
                        AutomationProperties.Name="{DynamicResource Mda.Text.Context.Room.IndoorEnvironment}"
                        ToolTip.Tip="{DynamicResource Mda.Text.Context.Room.IndoorEnvironmentHelp}">
                <TextBlock Text="{DynamicResource Mda.Text.Context.Room.IndoorEnvironment}" TextWrapping="Wrap" />
              </CheckBox>
              <Grid ColumnDefinitions="120,260,*"><TextBlock Text="{DynamicResource Mda.Text.304fd699a5e7}" Classes="label" /><ComboBox Grid.Column="1" ItemsSource="{Binding StyleChoices}" SelectedIndex="{Binding StyleIndex, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.304fd699a5e7}" ><ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorModelStyleChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <TextBlock Text="{DynamicResource Mda.Text.f36b2dcfe015}" Classes="caption" Margin="120,0,0,0" />
            </StackPanel>
            <Separator />
            <StackPanel Spacing="12">
              <TextBlock Text="{DynamicResource Mda.Text.0c2370d56d98}" Classes="section" />
              <Grid ColumnDefinitions="120,*,8,*,8,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                <TextBlock Grid.Column="1" Text="X" Classes="caption" /><TextBlock Grid.Column="3" Text="Y" Classes="caption" /><TextBlock Grid.Column="5" Text="Z" Classes="caption" />
                <TextBlock Grid.Row="2" Text="{DynamicResource Mda.Text.1fb4d574da92}" Classes="label" />
                <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding PositionX, Mode=TwoWay}" FormatString="0.####" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.ef503c467718}" />
                <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding PositionY, Mode=TwoWay}" FormatString="0.####" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.29f39916be48}" />
                <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="5" Value="{Binding PositionZ, Mode=TwoWay}" FormatString="0.####" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.12783e2a520f}" />
                <TextBlock Grid.Row="4" Text="{DynamicResource Mda.Text.bab4c7dc2948}" Classes="label" />
                <validated:EditorNumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding RotationX, Mode=TwoWay}" FormatString="0.####" Increment="1" AutomationProperties.Name="{DynamicResource Mda.Text.fbb64d80c38b}" />
                <validated:EditorNumericUpDown Grid.Row="4" Grid.Column="3" Value="{Binding RotationY, Mode=TwoWay}" FormatString="0.####" Increment="1" AutomationProperties.Name="{DynamicResource Mda.Text.8dd081605914}" />
                <validated:EditorNumericUpDown Grid.Row="4" Grid.Column="5" Value="{Binding RotationZ, Mode=TwoWay}" FormatString="0.####" Increment="1" AutomationProperties.Name="{DynamicResource Mda.Text.65db144cd8c1}" />
                <TextBlock Grid.Row="6" Text="{DynamicResource Mda.Text.505e4e9bda2c}" Classes="label" />
                <validated:EditorNumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding Scale, Mode=TwoWay}" FormatString="0.####" Minimum="0" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.bb6d776c311e}" />
              </Grid>
              <TextBlock Text="{DynamicResource Mda.Text.68344c74f266}" Classes="caption" Margin="120,0,0,0" />
            </StackPanel>
            <Separator />
            <StackPanel Spacing="12">
              <TextBlock Text="{DynamicResource Mda.Text.09b015983303}" Classes="section" />
              <StackPanel Orientation="Horizontal" Spacing="28">
                <CheckBox Content="IK" IsChecked="{Binding IkEnabled, Mode=TwoWay}" />
                <CheckBox Content="{DynamicResource Mda.Text.c762ed73d49b}" IsChecked="{Binding MorphsEnabled, Mode=TwoWay}" />
                <CheckBox Content="{DynamicResource Mda.Text.a454f17872a1}" IsChecked="{Binding PhysicsEnabled, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Text="{Binding SourcePath}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Mda.Text.e2102c085d2e}">
        <Grid ColumnDefinitions="260,1,*" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,*" Margin="16,0,12,16">
            <TextBlock Text="{DynamicResource Mda.Text.d9aed99189bf}" Classes="caption" Margin="8,0,0,8" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                     Background="{DynamicResource OutputSurface}" BorderThickness="0" AutomationProperties.Name="{DynamicResource Mda.Text.4da2e36af414}">
              <ListBox.ItemTemplate><DataTemplate x:DataType="local:EditorMaterialPropertiesItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Border Grid.Column="1" Background="{DynamicResource OutputBorder}" />
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding SelectedMaterial}" Margin="20,0,24,24">
              <ContentControl.ContentTemplate><DataTemplate x:DataType="local:EditorMaterialPropertiesItem">
                <StackPanel Spacing="16">
                  <TextBlock Text="{Binding Label}" Classes="section" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ExistingMapping}" Classes="caption" />
                  <StackPanel Spacing="8" IsVisible="{Binding SupportsOutlineScaling}">
                    <TextBlock Text="{DynamicResource Mda.Text.OutlineScale.Label}" Classes="label" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <validated:EditorNumericUpDown Name="MaterialOutlineScaleBox" Width="104" Value="{Binding OutlinePercent, Mode=TwoWay}" Minimum="0" Maximum="400" Increment="5" FormatString="0.##" AutomationProperties.Name="{DynamicResource Mda.Text.OutlineScale.Label}" />
                      <TextBlock Text="%" Classes="label" VerticalAlignment="Center" /><validated:EditorValueSlider Name="MaterialOutlineScaleSlider" Width="140" VerticalAlignment="Center" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Step="1" DefaultValue="100" Number="{Binding OutlinePercent, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" AutomationProperties.Name="{DynamicResource Mda.Text.OutlineScale.Label}" />
                      <Button Name="MaterialOutlineQuarterButton" Content="25%" Click="QuarterOutline" Classes="action" ToolTip.Tip="{DynamicResource Mda.Text.OutlineScale.Quarter}" />
                      <Button Name="MaterialOutlineResetButton" Content="100%" Click="ResetOutline" ToolTip.Tip="{DynamicResource Mda.Text.OutlineScale.Reset}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Mda.Text.OutlineScale.Hint}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Mda.Text.OutlineScale.ModernOnly}" Classes="caption" IsVisible="{Binding OutlineScalingUnavailable}" />
                  <StackPanel Spacing="6"><TextBlock Text="{DynamicResource Mda.Text.cef43d2017e8}" Classes="label" /><ComboBox ItemsSource="{Binding RoleChoices}" SelectedIndex="{Binding RoleIndex, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.b23e968e4359}" /></StackPanel>
                  <Border Background="{DynamicResource EditorInputSurface}" BorderBrush="{DynamicResource MdaDanger}" BorderThickness="1" CornerRadius="6" Padding="10"
                          IsVisible="{Binding HasStyleValidationMessage}">
                    <TextBlock Text="{Binding StyleValidationMessage}" TextWrapping="Wrap" />
                  </Border>
                  <TextBlock Text="{DynamicResource Mda.Text.ModelProps.MapRoleToConfigureModes}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding ShowMapRoleHint}" />
                  <StackPanel Spacing="16" IsEnabled="{Binding IsMapped}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{DynamicResource Mda.Text.ModelProps.DynamicModesHeader}" Classes="section" />
                      <TextBlock Text="{Binding DynamicModesHeaderHint}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDynamicModes}" />
                      <TextBlock Text="{Binding NoDynamicModesNotice}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasNoDynamicModes}" />
                      <ItemsControl ItemsSource="{Binding DynamicModes}" IsVisible="{Binding HasDynamicModes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:EditorStyleModeItem">
                            <Border Background="{DynamicResource OutputSurface}" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                              <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  </CheckBox>
                                  <Button Grid.Column="1" Content="{DynamicResource Mda.Text.ModelProps.ResetModeDefaults}"
                                          IsEnabled="{Binding IsEnabled}" Click="ResetStyleMode" />
                                </Grid>
                                <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                <Border Background="{DynamicResource EditorInputSurface}" BorderBrush="{DynamicResource MdaDanger}" BorderThickness="1" CornerRadius="4" Padding="8,6"
                                        IsVisible="{Binding ShowRoleRequirementNote}">
                                  <TextBlock Text="{Binding RoleRequirementNote}" Classes="caption" TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Spacing="12" IsVisible="{Binding IsEnabled}">
                                  <ItemsControl ItemsSource="{Binding TextureSlots}" IsVisible="{Binding HasTextureSlots}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="local:EditorStyleTextureSlotItem">
                                        <StackPanel Spacing="6" Margin="0,0,0,8">
                                          <TextBlock Text="{Binding PrimaryDisplayName}" Classes="label" TextWrapping="Wrap" ToolTip.Tip="{Binding Description}" />
                                          <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                          <ComboBox ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedPrimary, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorSourceChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                          </ComboBox>
                                          <StackPanel Spacing="6" IsVisible="{Binding SupportsSecondaryTexture}">
                                            <TextBlock Text="{Binding SecondaryDisplayName}" Classes="label" TextWrapping="Wrap" />
                                            <ComboBox ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedSecondary, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorSourceChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                          </StackPanel>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  <StackPanel Spacing="8" IsVisible="{Binding SupportsBoneTracking}">
                                    <TextBlock Text="{DynamicResource Mda.Text.ModelProps.BoneTrackingMode}" Classes="label" />
                                    <ComboBox ItemsSource="{Binding BoneTrackingModes}" SelectedIndex="{Binding BoneTrackingModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <StackPanel Spacing="8" IsVisible="{Binding IsFixedWorldTracking}">
                                      <TextBlock Text="{Binding FixedBasisSummary}" Classes="caption" TextWrapping="Wrap" />
                                      <ComboBox ItemsSource="{Binding Bones}" SelectedItem="{Binding SelectedBone, Mode=TwoWay}" PlaceholderText="{DynamicResource Mda.Text.12edb066408d}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorSourceChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                      </ComboBox>
                                      <Button Content="{DynamicResource Mda.Text.ModelProps.SampleBoneButton}" Click="SampleModeBoneBasis" HorizontalAlignment="Left" Classes="action" />
                                      <TextBlock Text="{DynamicResource Mda.Text.df7052f91b93}" Classes="caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="6" IsVisible="{Binding IsSelectedBoneTracking}">
                                      <TextBlock Text="{DynamicResource Mda.Text.ModelProps.TargetBoneLabel}" Classes="label" />
                                      <ComboBox ItemsSource="{Binding Bones}" SelectedItem="{Binding SelectedBone, Mode=TwoWay}" PlaceholderText="{DynamicResource Mda.Text.12edb066408d}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorSourceChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                      </ComboBox>
                                      <TextBlock Text="{Binding LocalAxisSummary}" Classes="caption" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </StackPanel>
                                  <ItemsControl ItemsSource="{Binding Parameters}" IsVisible="{Binding HasParameters}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="local:EditorStyleParameterItem">
                                        <StackPanel Spacing="6" Margin="0,4,0,6">
                                          <StackPanel Spacing="4" IsVisible="{Binding IsFloat}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="label" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                            <Grid ColumnDefinitions="*,10,96">
                                              <validated:EditorValueSlider Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Step="{Binding StepSize}"
                                                                           DefaultValue="{Binding DefaultDouble}" Number="{Binding DecimalValue, Mode=TwoWay}"
                                                                           ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" />
                                              <validated:EditorNumericUpDown Grid.Column="2" Minimum="{Binding MinDecimal}" Maximum="{Binding MaxDecimal}"
                                                                             Increment="{Binding StepDecimal}" Value="{Binding DecimalValue, Mode=TwoWay}" FormatString="0.###" />
                                            </Grid>
                                          </StackPanel>
                                          <StackPanel Spacing="4" IsVisible="{Binding IsInt}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="label" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                            <validated:EditorNumericUpDown Width="136" HorizontalAlignment="Left" Minimum="{Binding MinDecimal}" Maximum="{Binding MaxDecimal}"
                                                                           Increment="{Binding StepDecimal}" Value="{Binding DecimalValue, Mode=TwoWay}" FormatString="0" />
                                          </StackPanel>
                                          <StackPanel Spacing="4" IsVisible="{Binding IsBool}">
                                            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" ToolTip.Tip="{Binding Description}">
                                              <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                          </StackPanel>
                                          <StackPanel Spacing="4" IsVisible="{Binding IsEnum}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="label" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                            <ComboBox ItemsSource="{Binding EnumChoices}" SelectedItem="{Binding SelectedEnumChoice, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorStyleEnumChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                          </StackPanel>
                                          <StackPanel Spacing="4" IsVisible="{Binding IsColor}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="label" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                            <Grid ColumnDefinitions="Auto,*,6,*,6,*,6,*">
                                              <Border Width="26" Height="26" CornerRadius="4" Margin="0,16,8,0" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="1"
                                                      Background="{Binding ColorPreviewBrush}" ToolTip.Tip="{DynamicResource Mda.Text.ModelProps.ColorPreviewTooltip}" />
                                              <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="R" Classes="caption" />
                                                <validated:EditorNumericUpDown Minimum="0" Maximum="{Binding ColorChannelMaxDecimal}" Increment="0.02" Value="{Binding VecX, Mode=TwoWay}" FormatString="0.###" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="3" Spacing="2">
                                                <TextBlock Text="G" Classes="caption" />
                                                <validated:EditorNumericUpDown Minimum="0" Maximum="{Binding ColorChannelMaxDecimal}" Increment="0.02" Value="{Binding VecY, Mode=TwoWay}" FormatString="0.###" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="5" Spacing="2">
                                                <TextBlock Text="B" Classes="caption" />
                                                <validated:EditorNumericUpDown Minimum="0" Maximum="{Binding ColorChannelMaxDecimal}" Increment="0.02" Value="{Binding VecZ, Mode=TwoWay}" FormatString="0.###" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="7" Spacing="2" IsVisible="{Binding IsColor4}">
                                                <TextBlock Text="A" Classes="caption" />
                                                <validated:EditorNumericUpDown Minimum="0" Maximum="1" Increment="0.02" Value="{Binding VecW, Mode=TwoWay}" FormatString="0.###" />
                                              </StackPanel>
                                            </Grid>
                                          </StackPanel>
                                          <StackPanel Spacing="4" IsVisible="{Binding IsVector}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="label" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                            <Grid ColumnDefinitions="*,6,*,6,*,6,*">
                                              <StackPanel Spacing="2">
                                                <TextBlock Text="X" Classes="caption" />
                                                <validated:EditorNumericUpDown Minimum="-10000" Maximum="10000" Increment="0.05" Value="{Binding VecX, Mode=TwoWay}" FormatString="0.###" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="Y" Classes="caption" />
                                                <validated:EditorNumericUpDown Minimum="-10000" Maximum="10000" Increment="0.05" Value="{Binding VecY, Mode=TwoWay}" FormatString="0.###" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="4" Spacing="2" IsVisible="{Binding ShowVectorZ}">
                                                <TextBlock Text="Z" Classes="caption" />
                                                <validated:EditorNumericUpDown Minimum="-10000" Maximum="10000" Increment="0.05" Value="{Binding VecZ, Mode=TwoWay}" FormatString="0.###" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="6" Spacing="2" IsVisible="{Binding ShowVectorW}">
                                                <TextBlock Text="W" Classes="caption" />
                                                <validated:EditorNumericUpDown Minimum="-10000" Maximum="10000" Increment="0.05" Value="{Binding VecW, Mode=TwoWay}" FormatString="0.###" />
                                              </StackPanel>
                                            </Grid>
                                          </StackPanel>
                                          <StackPanel Spacing="4" IsVisible="{Binding IsTextureSlot}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="label" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                            <ComboBox ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTextureChoice, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorSourceChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                          </StackPanel>
                                          <StackPanel Spacing="4" IsVisible="{Binding IsBoneName}">
                                            <TextBlock Text="{Binding DisplayName}" Classes="label" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                            <ComboBox ItemsSource="{Binding Bones}" SelectedItem="{Binding SelectedBoneChoice, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                              <ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorSourceChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                          </StackPanel>
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <Separator />
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentHeader}" Classes="section" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{DynamicResource Mda.Text.ModelProps.ResetPmxTreatment}" Click="ResetPmxTreatment" IsEnabled="{Binding IsBodyOrHair}" />
                      </Grid>
                      <TextBlock Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentBodyHairOnlyNote}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsNotBodyOrHair}" />
                      <Grid ColumnDefinitions="Auto,*,12,84" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto" IsEnabled="{Binding IsBodyOrHair}">
                        <TextBlock Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentSaturation}" Classes="label" />
                        <validated:EditorValueSlider Grid.Column="1" Margin="16,0,0,0" Minimum="0" Maximum="2" SmallChange="0.01" LargeChange="0.1" Step="0.01" DefaultValue="1" Number="{Binding PmxSaturation, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" />
                        <validated:EditorNumericUpDown Grid.Column="3" Minimum="0" Maximum="2" Increment="0.05" FormatString="0.##" Value="{Binding PmxSaturation, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentTransition}" Classes="label" />
                        <validated:EditorValueSlider Grid.Row="2" Grid.Column="1" Margin="16,0,0,0" Minimum="0.5" Maximum="1.5" SmallChange="0.01" LargeChange="0.1" Step="0.01" DefaultValue="1" Number="{Binding PmxTransitionWidthScale, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" />
                        <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0.5" Maximum="1.5" Increment="0.05" FormatString="0.##" Value="{Binding PmxTransitionWidthScale, Mode=TwoWay}" />
                        <TextBlock Grid.Row="4" Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentContrast}" Classes="label" />
                        <validated:EditorValueSlider Grid.Row="4" Grid.Column="1" Margin="16,0,0,0" Minimum="-0.5" Maximum="0.5" SmallChange="0.01" LargeChange="0.1" Step="0.01" DefaultValue="0" Number="{Binding PmxValueContrast, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" />
                        <validated:EditorNumericUpDown Grid.Row="4" Grid.Column="3" Minimum="-0.5" Maximum="0.5" Increment="0.02" FormatString="0.##" Value="{Binding PmxValueContrast, Mode=TwoWay}" />
                        <TextBlock Grid.Row="6" Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentGamma}" Classes="label" />
                        <validated:EditorValueSlider Grid.Row="6" Grid.Column="1" Margin="16,0,0,0" Minimum="0.5" Maximum="2" SmallChange="0.01" LargeChange="0.1" Step="0.01" DefaultValue="1" Number="{Binding PmxShadeGamma, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" />
                        <validated:EditorNumericUpDown Grid.Row="6" Grid.Column="3" Minimum="0.5" Maximum="2" Increment="0.05" FormatString="0.##" Value="{Binding PmxShadeGamma, Mode=TwoWay}" />
                        <TextBlock Grid.Row="8" Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentHairStrength}" Classes="label" IsEnabled="{Binding IsHairRole}" />
                        <validated:EditorValueSlider Grid.Row="8" Grid.Column="1" Margin="16,0,0,0" Minimum="0" Maximum="0.4" SmallChange="0.01" LargeChange="0.05" Step="0.01" DefaultValue="0" Number="{Binding PmxHairHighlightStrength, Mode=TwoWay}" IsEnabled="{Binding IsHairRole}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" />
                        <validated:EditorNumericUpDown Grid.Row="8" Grid.Column="3" Minimum="0" Maximum="0.4" Increment="0.02" FormatString="0.##" Value="{Binding PmxHairHighlightStrength, Mode=TwoWay}" IsEnabled="{Binding IsHairRole}" />
                        <TextBlock Grid.Row="10" Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentHairWidth}" Classes="label" IsEnabled="{Binding IsHairRole}" />
                        <validated:EditorValueSlider Grid.Row="10" Grid.Column="1" Margin="16,0,0,0" Minimum="0.02" Maximum="0.4" SmallChange="0.01" LargeChange="0.05" Step="0.01" DefaultValue="0.12" Number="{Binding PmxHairHighlightWidth, Mode=TwoWay}" IsEnabled="{Binding IsHairRole}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" />
                        <validated:EditorNumericUpDown Grid.Row="10" Grid.Column="3" Minimum="0.02" Maximum="0.4" Increment="0.02" FormatString="0.##" Value="{Binding PmxHairHighlightWidth, Mode=TwoWay}" IsEnabled="{Binding IsHairRole}" />
                      </Grid>
                      <TextBlock Text="{DynamicResource Mda.Text.ModelProps.PmxTreatmentHairOnlyNote}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsMappedAndNotHair}" />
                    </StackPanel>
                    <Separator />
                    <TextBlock Text="{DynamicResource Mda.Text.bc6ec863ba1f}" Classes="section" />
                    <Grid ColumnDefinitions="Auto,*,12,80" RowDefinitions="Auto,8,Auto,8,Auto">
                      <TextBlock Text="{DynamicResource Mda.Text.f86b04271b8b}" Classes="label" /><validated:EditorNumericUpDown Grid.Column="3" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" Value="{Binding FaceNormal, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.f86b04271b8b}" /><validated:EditorValueSlider Grid.Column="1" Margin="16,0,0,0" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Step="0.01" DefaultValue="0.35" Number="{Binding FaceNormal, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" AutomationProperties.Name="{DynamicResource Mda.Text.f86b04271b8b}" />
                      <TextBlock Grid.Row="2" Text="{DynamicResource Mda.Text.a561f39d9414}" Classes="label" /><validated:EditorNumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" Value="{Binding FaceShadow, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.a561f39d9414}" /><validated:EditorValueSlider Grid.Row="2" Grid.Column="1" Margin="16,0,0,0" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Step="0.01" DefaultValue="1" Number="{Binding FaceShadow, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" AutomationProperties.Name="{DynamicResource Mda.Text.a561f39d9414}" />
                      <TextBlock Grid.Row="4" Text="{DynamicResource Mda.Text.4ffd43c901b5}" Classes="label" /><validated:EditorNumericUpDown Grid.Row="4" Grid.Column="3" Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" Value="{Binding EyeShadow, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.4ffd43c901b5}" /><validated:EditorValueSlider Grid.Row="4" Grid.Column="1" Margin="16,0,0,0" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Step="0.01" DefaultValue="0.2" Number="{Binding EyeShadow, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" AutomationProperties.Name="{DynamicResource Mda.Text.4ffd43c901b5}" />
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Mda.Text.0f2f1c84628a}" Classes="caption" />
                </StackPanel>
              </DataTemplate></ContentControl.ContentTemplate>
            </ContentControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource Mda.Text.6e814135ad1b}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,24">
          <StackPanel Spacing="6" Margin="0,0,0,12"><TextBlock Text="{DynamicResource Mda.Text.d142c7fa4f24}" Classes="section" /><TextBlock Text="{Binding ProfileSummary}" Classes="caption" /><TextBlock Text="{DynamicResource Mda.Text.a6136d33bb49}" Classes="caption" /></StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="{DynamicResource Mda.Text.d99a10e23577}" Click="ImportMapping" Classes="action" /><Button Content="{DynamicResource Mda.Text.b59c656f3dc5}" Click="ExportMapping" />
            <Button Content="{DynamicResource Mda.Text.fdd71675e53a}" Click="RefreshJson" /><Button Content="{DynamicResource Mda.Text.2d35cd3c3e35}" Click="ApplyJson" />
          </StackPanel>
          <TextBox Name="ModelProfileJsonBox" Grid.Row="2" Height="NaN" MinHeight="180" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                   VerticalContentAlignment="Top" Padding="10" MaxLength="1048576" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Mda.Text.8f696546156c}" />
          <TextBlock Grid.Row="3" Text="{DynamicResource Mda.Text.affd0a1c1099}" Classes="caption" Margin="0,12,0,0" />
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="0,1,0,0" Padding="24,12,24,16">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Mda.Text.d037425c3386}" Classes="caption" Margin="0,0,20,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="quiet" Content="{DynamicResource Mda.Text.2cd0f3be8738}" Click="CancelProperties" IsCancel="True" /><Button Name="ApplyModelPropertiesButton" Classes="primary" Content="{DynamicResource Mda.Text.63c73c4730f4}" Click="ApplyProperties" IsDefault="True" /></StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
