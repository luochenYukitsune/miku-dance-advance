<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mmd.Modern.App.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="avares://Mmd.Modern.App/Assets/Icons/PhosphorRegular.axaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Mmd.Modern.App/Assets/Fonts#HarmonyOS Sans SC" />
    </Style>
  </Application.Styles>
</Application>
