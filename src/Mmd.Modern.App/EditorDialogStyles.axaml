<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dialogs built in code (confirm, choose, plugins, recovery, MMEffect assignment, Toon slots...).
       They have no XAML of their own, so without this file their buttons fall back to the
       fixed light SukiUI/Simple template and become unreadable on the dark palette.
       Palette keys come from EditorPopupStyles.axaml (included first). -->
  <StyleInclude Source="avares://Mmd.Modern.App/EditorPopupStyles.axaml" />

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource EditorSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
  </Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource EditorText}" /></Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="4" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource MdaButton}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MdaButtonBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    <Setter Property="Transitions"><Transitions /></Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource MdaButtonHover}" /></Style>
  <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource MdaButtonPressed}" /></Style>
  <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource MdaAccentSoft}" /></Style>
  <Style Selector="Button:disabled"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" /><Setter Property="Opacity" Value="1" /><Setter Property="Background" Value="{DynamicResource MdaButtonDisabled}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button[IsDefault=True]">
    <Setter Property="Background" Value="{DynamicResource MdaAccent}" /><Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" />
  </Style>
  <Style Selector="Button[IsDefault=True] /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" /></Style>
  <Style Selector="Button[IsDefault=True]:pointerover"><Setter Property="Background" Value="{DynamicResource MdaAccentHover}" /></Style>
  <Style Selector="Button[IsDefault=True]:disabled"><Setter Property="Background" Value="{DynamicResource MdaButtonDisabled}" /></Style>
  <Style Selector="Button[IsDefault=True]:disabled /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledText}" /></Style>
  <!-- Cancel and other quiet actions: flat, no border. -->
  <Style Selector="Button[IsCancel=True]"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="Button[IsCancel=True]:pointerover"><Setter Property="Background" Value="{DynamicResource MdaButtonHover}" /></Style>
  <!-- Destructive confirm (e.g. delete pages): accent swapped for the error tone. -->
  <Style Selector="Button.danger"><Setter Property="Background" Value="{DynamicResource MdaDanger}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="Button.danger /template/ ContentPresenter"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
  <Style Selector="Button.danger:pointerover"><Setter Property="Background" Value="{DynamicResource MdaDangerHover}" /></Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource EditorPanelSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EditorBorder}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource EditorText}" /></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource EditorHover}" /></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource EditorSelectedSurface}" /></Style>
  <Style Selector="ListBoxItem:selected"><Setter Property="Foreground" Value="{DynamicResource EditorText}" /></Style>
  <!-- Expander (plugin folder): the SukiUI template draws a black card and a glyph that is
       missing from the bundled font. A flat header with a drawn chevron replaces it. -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <ToggleButton Name="ExpanderHeader" DockPanel.Dock="Top" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        Background="Transparent" BorderThickness="0" Padding="6,4" HorizontalAlignment="Left">
            <ToggleButton.Template>
              <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Name="Chevron" Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource EditorMuted}" StrokeThickness="1.5"
                          VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </ControlTemplate>
            </ToggleButton.Template>
            <ContentPresenter Content="{TemplateBinding Header}" Foreground="{DynamicResource EditorText}" />
          </ToggleButton>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}" Margin="0,6,0,0" />
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover"><Setter Property="Background" Value="{DynamicResource EditorHover}" /></Style>
  <Style Selector="Expander:expanded /template/ Path#Chevron"><Setter Property="RenderTransform" Value="rotate(90deg)" /></Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource EditorInputSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource EditorBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorText}" /><Setter Property="CornerRadius" Value="4" />
  </Style>
</Styles>
