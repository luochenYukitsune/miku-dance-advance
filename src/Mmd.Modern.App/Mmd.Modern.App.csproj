<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/Branding/mda.ico</ApplicationIcon></PropertyGroup>
  <PropertyGroup Condition="'$(MdaAppVersion)' != ''">
    <MdaAppNumericVersion Condition="'$(MdaAppNumericVersion)' == ''">$(MdaAppVersion.Split('-')[0])</MdaAppNumericVersion>
    <Version>$(MdaAppVersion)</Version>
    <AssemblyVersion>$(MdaAppNumericVersion)</AssemblyVersion>
    <FileVersion>$(MdaAppNumericVersion)</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MdaAppInformationalVersion)' != ''">
    <InformationalVersion>$(MdaAppInformationalVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Mmd.Modern.Application.ExperimentalPhysicalPreviewLeaves" Value="false" />
    <ProjectReference Include="../Mmd.Modern.Core/Mmd.Modern.Core.csproj" />
    <ProjectReference Include="../Mmd.Modern.Animation/Mmd.Modern.Animation.csproj" />
    <ProjectReference Include="../Mmd.Modern.Application/Mmd.Modern.Application.csproj" />
    <ProjectReference Include="../Mmd.Modern.Plugins/Mmd.Modern.Plugins.csproj" />
    <ProjectReference Include="../Mmd.Modern.ViewOutput/Mmd.Modern.ViewOutput.csproj" />
    <ProjectReference Include="../Mmd.Modern.ViewOutput.FFmpeg/Mmd.Modern.ViewOutput.FFmpeg.csproj" />
    <ProjectReference Include="../Mmd.Modern.ViewOutput.D3D12/Mmd.Modern.ViewOutput.D3D12.csproj" />
    <ProjectReference Include="../Mmd.Modern.ViewOutput.D3D9.Compatibility/Mmd.Modern.ViewOutput.D3D9.Compatibility.csproj" />
    <ProjectReference Include="../Mmd.Modern.Physics.Runtime/Mmd.Modern.Physics.Runtime.csproj" />
    <ProjectReference Include="../Mmd.Modern.Rendering.D3D12/Mmd.Modern.Rendering.D3D12.csproj" />
    <ProjectReference Include="../Mmd.Modern.Formats/Mmd.Modern.Formats.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="SukiUI" Version="5.3.0" />
    <PackageReference Include="Pfim" Version="0.11.4" />
    <AvaloniaResource Include="Assets/**" />
    <None Update="LICENSE.Pfim.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="licenses/MDA/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSING.md" Link="licenses/MDA/LICENSING.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="licenses/MDA/THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Fonts/LICENSE_Fonts" TargetPath="licenses/HarmonyOS-Sans/LICENSE_Fonts" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets/Fonts/provenance.json" TargetPath="licenses/HarmonyOS-Sans/provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <_BundledStylePlugin Include="../Mda.StylePlugin.Genshin/Mda.StylePlugin.Genshin.csproj"
                         PluginId="mda.style.genshin"
                         ProjectName="Mda.StylePlugin.Genshin" />
    <_BundledStylePlugin Include="../Mda.StylePlugin.StarRail/Mda.StylePlugin.StarRail.csproj"
                         PluginId="mda.style.star-rail"
                         ProjectName="Mda.StylePlugin.StarRail" />
    <_BundledStylePlugin Include="../Mda.StylePlugin.WutheringWaves/Mda.StylePlugin.WutheringWaves.csproj"
                         PluginId="mda.style.wuthering-waves"
                         ProjectName="Mda.StylePlugin.WutheringWaves" />
    <_BundledStylePlugin Include="../Mda.StylePlugin.Endfield/Mda.StylePlugin.Endfield.csproj"
                         PluginId="mda.style.endfield"
                         ProjectName="Mda.StylePlugin.Endfield" />
  </ItemGroup>
  <Target Name="_BuildBundledStylePlugins"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_PluginPlatformSegment Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'Any CPU'">$(Platform)/</_PluginPlatformSegment>
      <_PluginCacheRoot Condition="'$(RuntimeIdentifier)' == ''">$(ModernCacheRoot)</_PluginCacheRoot>
      <_PluginCacheRoot Condition="'$(RuntimeIdentifier)' != ''">$(ModernCacheRoot)/style-plugins</_PluginCacheRoot>
      <_PluginRestoreLockedMode Condition="'$(RuntimeIdentifier)' == ''">true</_PluginRestoreLockedMode>
      <_PluginRestoreLockedMode Condition="'$(RuntimeIdentifier)' != ''">false</_PluginRestoreLockedMode>
    </PropertyGroup>
    <ItemGroup>
      <_BundledStylePluginToRestore Include="@(_BundledStylePlugin)"
                                    Condition="!Exists('$(_PluginCacheRoot)/obj/%(ProjectName)/project.assets.json')" />
    </ItemGroup>
    <MSBuild Condition="'@(_BundledStylePluginToRestore)' != ''"
             Projects="@(_BundledStylePluginToRestore)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ModernCacheRoot=$(_PluginCacheRoot);RestoreLockedMode=$(_PluginRestoreLockedMode)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;PublishDir;OutDir;OutputPath;TargetDir;MdaAppVersion;MdaAppInformationalVersion;Version;AssemblyVersion;FileVersion;InformationalVersion;VersionPrefix;VersionSuffix;SourceRevisionId"
             BuildInParallel="false" />
    <MSBuild Projects="@(_BundledStylePlugin)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ModernCacheRoot=$(_PluginCacheRoot)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;PublishDir;OutDir;OutputPath;TargetDir;MdaAppVersion;MdaAppInformationalVersion;Version;AssemblyVersion;FileVersion;InformationalVersion;VersionPrefix;VersionSuffix;SourceRevisionId"
             BuildInParallel="false" />
  </Target>
  <Target Name="StageBundledStylePlugins"
          AfterTargets="Build"
          DependsOnTargets="_BuildBundledStylePlugins"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_StageTargetDir>$([MSBuild]::EnsureTrailingSlash('$(TargetDir)'))</_StageTargetDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_PluginCacheRoot)/bin/%(_BundledStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/%(_BundledStylePlugin.ProjectName).dll;$(_PluginCacheRoot)/bin/%(_BundledStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/%(_BundledStylePlugin.ProjectName).deps.json;$(_PluginCacheRoot)/bin/%(_BundledStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/mda-plugin.json"
          DestinationFolder="$(_StageTargetDir)plugins/%(_BundledStylePlugin.PluginId)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_StrayBuiltPluginFiles Include="$(_StageTargetDir)plugins/*/*.pdb;$(_StageTargetDir)plugins/*/Mmd.Modern.Plugins.Contracts.dll" />
    </ItemGroup>
    <Delete Files="@(_StrayBuiltPluginFiles)" />
  </Target>
  <Target Name="StageBundledStylePluginsForPublish"
          AfterTargets="Publish"
          DependsOnTargets="_BuildBundledStylePlugins"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <PropertyGroup>
      <_StagePublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_StagePublishDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_PluginCacheRoot)/bin/%(_BundledStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/%(_BundledStylePlugin.ProjectName).dll;$(_PluginCacheRoot)/bin/%(_BundledStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/%(_BundledStylePlugin.ProjectName).deps.json;$(_PluginCacheRoot)/bin/%(_BundledStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/mda-plugin.json"
          DestinationFolder="$(_StagePublishDir)plugins/%(_BundledStylePlugin.PluginId)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_StrayPublishedPluginFiles Include="$(_StagePublishDir)plugins/*/*.pdb;$(_StagePublishDir)plugins/*/Mmd.Modern.Plugins.Contracts.dll" />
    </ItemGroup>
    <Delete Files="@(_StrayPublishedPluginFiles)" />
    <Error Condition="!Exists('$(_StagePublishDir)plugins/%(_BundledStylePlugin.PluginId)/%(_BundledStylePlugin.ProjectName).dll')"
           Text="Bundled style plugin assembly missing after publish staging: %(_BundledStylePlugin.PluginId)/%(_BundledStylePlugin.ProjectName).dll" />
    <Error Condition="!Exists('$(_StagePublishDir)plugins/%(_BundledStylePlugin.PluginId)/%(_BundledStylePlugin.ProjectName).deps.json')"
           Text="Bundled style plugin deps.json missing after publish staging: %(_BundledStylePlugin.PluginId)/%(_BundledStylePlugin.ProjectName).deps.json" />
    <Error Condition="!Exists('$(_StagePublishDir)plugins/%(_BundledStylePlugin.PluginId)/mda-plugin.json')"
           Text="Bundled style plugin manifest missing after publish staging: %(_BundledStylePlugin.PluginId)/mda-plugin.json" />
    <Error Condition="Exists('$(_StagePublishDir)plugins/%(_BundledStylePlugin.PluginId)/Mmd.Modern.Plugins.Contracts.dll')"
           Text="Private copy of Mmd.Modern.Plugins.Contracts.dll must not be staged inside plugin %(_BundledStylePlugin.PluginId)." />
  </Target>
</Project>
