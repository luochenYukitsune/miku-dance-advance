<Window xmlns:validated="using:Mmd.Modern.App.Controls" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Mmd.Modern.App"
        x:Class="Mmd.Modern.App.EditorLightingWindow" x:DataType="local:EditorLightingViewModel"
        Title="{DynamicResource Mda.Text.d2b7ed607969}" Width="900" Height="720" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource OutputSurface}" Foreground="{DynamicResource OutputText}"
        FontFamily="avares://Mmd.Modern.App/Assets/Fonts#HarmonyOS Sans SC" FontSize="14"
        UseLayoutRounding="True" RenderOptions.TextRenderingMode="Antialias">
  <!-- Shared visual contracts copied from the verified native OutputSettingsWindow. -->
  <Window.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="OutputFont">avares://Mmd.Modern.App/Assets/Fonts#HarmonyOS Sans SC</FontFamily>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="OutputSurface" Color="#0F1216" /><SolidColorBrush x:Key="OutputText" Color="#ECEFF2" />
          <SolidColorBrush x:Key="OutputMuted" Color="#A4ACB6" /><SolidColorBrush x:Key="OutputDisabled" Color="#69717B" />
          <SolidColorBrush x:Key="OutputBorder" Color="#2B333D" /><SolidColorBrush x:Key="OutputFocus" Color="#3DD68C" />
          <SolidColorBrush x:Key="OutputHover" Color="#222A34" /><SolidColorBrush x:Key="OutputSelected" Color="#19302A" />
          <SolidColorBrush x:Key="OutputInput" Color="#1B2129" /><SolidColorBrush x:Key="MdaAccent" Color="#2BB673" /><SolidColorBrush x:Key="MdaAccentText" Color="#06140C" /><SolidColorBrush x:Key="MdaAccentHover" Color="#35C77F" /><SolidColorBrush x:Key="MdaAccentSoft" Color="#3DD68C" /><SolidColorBrush x:Key="MdaAccentDisabled" Color="#1B2129" /><Color x:Key="SukiPrimaryColor">#2BB673</Color><SolidColorBrush x:Key="MdaButton" Color="#1F262F" /><SolidColorBrush x:Key="MdaButtonBorder" Color="#323C48" /><SolidColorBrush x:Key="MdaButtonHover" Color="#2A333E" /><SolidColorBrush x:Key="MdaButtonPressed" Color="#34404D" /><SolidColorBrush x:Key="MdaButtonDisabled" Color="#171C22" /><SolidColorBrush x:Key="EditorDisabledTextShared" Color="#69717B" /></ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="OutputSurface" Color="#F6F7F9" /><SolidColorBrush x:Key="OutputText" Color="#1A1D21" />
          <SolidColorBrush x:Key="OutputMuted" Color="#5B636E" /><SolidColorBrush x:Key="OutputDisabled" Color="#9AA1AA" />
          <SolidColorBrush x:Key="OutputBorder" Color="#D9DEE5" /><SolidColorBrush x:Key="OutputFocus" Color="#12844A" />
          <SolidColorBrush x:Key="OutputHover" Color="#E9EDF2" /><SolidColorBrush x:Key="OutputSelected" Color="#DFF2E7" />
          <SolidColorBrush x:Key="OutputInput" Color="#EEF1F4" /><SolidColorBrush x:Key="MdaAccent" Color="#12844A" /><SolidColorBrush x:Key="MdaAccentText" Color="#FFFFFF" /><SolidColorBrush x:Key="MdaAccentHover" Color="#0F7340" /><SolidColorBrush x:Key="MdaAccentSoft" Color="#12844A" /><SolidColorBrush x:Key="MdaAccentDisabled" Color="#EEF1F4" /><Color x:Key="SukiPrimaryColor">#12844A</Color><SolidColorBrush x:Key="MdaButton" Color="#F7F8FA" /><SolidColorBrush x:Key="MdaButtonBorder" Color="#CDD4DC" /><SolidColorBrush x:Key="MdaButtonHover" Color="#EEF1F4" /><SolidColorBrush x:Key="MdaButtonPressed" Color="#E3E8EE" /><SolidColorBrush x:Key="MdaButtonDisabled" Color="#EEF0F3" /><SolidColorBrush x:Key="EditorDisabledTextShared" Color="#9AA1AA" /></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://SukiUI/Theme/Index.xaml" />
    <Style Selector="Control"><Setter Property="UseLayoutRounding" Value="True" /></Style>
    <Style Selector="TemplatedControl"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource OutputText}" /></Style>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" /><Setter Property="Foreground" Value="{DynamicResource OutputText}" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="AccessText"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LineHeight" Value="22" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" /></Style>
    <Style Selector="Button">
      <Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="{DynamicResource OutputSurface}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.action"><Setter Property="Background" Value="{DynamicResource OutputInput}" /></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource OutputSelected}" /></Style>
    <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource OutputBorder}" /><Setter Property="Background" Value="{DynamicResource OutputInput}" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="SelectionBrush" Value="{DynamicResource OutputSelected}" /><Setter Property="CaretBrush" Value="{DynamicResource OutputText}" />
      <!-- Avalonia 11.3.22 Simple TextBox named parts, with no extra Suki 5.3.0 outer inset. -->
      <Setter Property="Template"><ControlTemplate>
        <Border Name="OutputInputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <DockPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <TextBlock Name="floatingWatermark" DockPanel.Dock="Top" Text="{TemplateBinding Watermark}" Foreground="{DynamicResource OutputMuted}">
              <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="UseFloatingWatermark" RelativeSource="{RelativeSource TemplatedParent}" />
                <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
              </MultiBinding></TextBlock.IsVisible>
            </TextBlock>
            <DataValidationErrors>
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentPresenter Content="{TemplateBinding InnerLeftContent}" />
                <ScrollViewer Name="PART_ScrollViewer" Grid.Column="1" AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                              BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                              HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}">
                  <Panel>
                    <TextBlock Name="watermark" Text="{TemplateBinding Watermark}" Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                               TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                      <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                        <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                      </MultiBinding></TextBlock.IsVisible>
                    </TextBlock>
                    <TextPresenter Name="PART_TextPresenter" CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                   CaretBrush="{TemplateBinding CaretBrush}" CaretIndex="{TemplateBinding CaretIndex}"
                                   LineHeight="{TemplateBinding LineHeight}" LetterSpacing="{TemplateBinding LetterSpacing}"
                                   PasswordChar="{TemplateBinding PasswordChar}" RevealPassword="{TemplateBinding RevealPassword}"
                                   SelectionBrush="{TemplateBinding SelectionBrush}" SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                   SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}"
                                   Text="{TemplateBinding Text, Mode=TwoWay}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" />
                  </Panel>
                </ScrollViewer>
                <ContentPresenter Grid.Column="2" Content="{TemplateBinding InnerRightContent}" />
              </Grid>
            </DataValidationErrors>
          </DockPanel>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="TextBox:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource OutputInput}" /><Setter Property="BorderBrush" Value="{DynamicResource OutputBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="ShowButtonSpinner" Value="False" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><ControlTemplate><ButtonSpinner Name="PART_Spinner" AllowSpin="{TemplateBinding AllowSpin}" ShowButtonSpinner="False" HorizontalContentAlignment="Stretch" Padding="0"><ButtonSpinner.Template><ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" /></ControlTemplate></ButtonSpinner.Template><TextBox Name="PART_TextBox" Text="{TemplateBinding Text}" Watermark="{TemplateBinding Watermark}" IsReadOnly="{TemplateBinding IsReadOnly}" TextAlignment="{TemplateBinding TextAlignment}"
        FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" /></ButtonSpinner></ControlTemplate></Setter>
    </Style>
    <Style Selector="NumericUpDown:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="NumericUpDown:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="NumericUpDown:disabled /template/ TextBox"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource OutputInput}" /><Setter Property="BorderBrush" Value="{DynamicResource OutputBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="PlaceholderForeground" Value="{DynamicResource OutputMuted}" />
      <!-- Preserve Avalonia 11.3.22 ComboBox selection, popup and editable named parts without the Suki outer inset. -->
      <Setter Property="Template"><ControlTemplate>
        <Border Name="OutputComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Grid ColumnDefinitions="*,24">
            <TextBlock Name="PlaceholderTextBlock" Margin="{TemplateBinding Padding}" Foreground="{TemplateBinding PlaceholderForeground}"
                       Text="{TemplateBinding PlaceholderText}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="SelectionBoxItem" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static ObjectConverters.IsNull}" />
                <Binding Path="!IsEditable" RelativeSource="{RelativeSource TemplatedParent}" />
              </MultiBinding></TextBlock.IsVisible>
            </TextBlock>
            <ContentControl Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding IsEditable, Converter={x:Static BoolConverters.Not}}" />
            <TextBox Name="PART_EditableTextBox" Height="NaN" MinHeight="0" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                     Background="Transparent" BorderThickness="0" Text="{TemplateBinding Text, Mode=TwoWay}" IsVisible="{TemplateBinding IsEditable}" />
            <ToggleButton Name="toggle" Grid.Column="1" Width="24" MinWidth="0" MinHeight="0" Margin="0" Padding="0"
                          Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                          IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}">
              <ToggleButton.Template><ControlTemplate><Border Background="{TemplateBinding Background}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></ToggleButton.Template>
              <Path Width="8" Height="4" Stretch="Uniform" Fill="{DynamicResource OutputMuted}"
                    Data="F1 M 301.14,-189.041L 311.57,-189.041L 306.355,-182.942L 301.14,-189.041 Z" />
            </ToggleButton>
            <Popup Name="PART_Popup" MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}" IsLightDismissEnabled="True"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{TemplateBinding}" InheritsTransform="True">
              <Border Background="{DynamicResource OutputSurface}" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="1"
                      RenderOptions.TextRenderingMode="Antialias" UseLayoutRounding="True">
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                              VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                              IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}" IsScrollChainingEnabled="False">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="ComboBox:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="ComboBox:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="ComboBox /template/ ContentPresenter"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="ComboBoxItem"><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="10,6" /><Setter Property="MinHeight" Value="30" /><Setter Property="Background" Value="{DynamicResource OutputSurface}" /><Setter Property="Foreground" Value="{DynamicResource OutputText}" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" RenderOptions.TextRenderingMode="Antialias" UseLayoutRounding="True"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="ComboBoxItem:selected"><Setter Property="Background" Value="{DynamicResource OutputSelected}" /></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="FontFamily" Value="{DynamicResource OutputFont}" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource OutputText}" /></Style>
    <Style Selector="CheckBox /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OutputText}" /></Style>
    <Style Selector="CheckBox:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource OutputDisabled}" /></Style>
    <Style Selector="TabControl"><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="{DynamicResource OutputSurface}" /></Style>
    <Style Selector="TabItem">
      <Setter Property="Height" Value="38" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="20,0" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" />
      <Setter Property="Template"><ControlTemplate><Border Name="OutputTabSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource OutputText}" /><Setter Property="Background" Value="{DynamicResource OutputSelected}" /></Style>
    <Style Selector="TabItem:selected /template/ Border#OutputTabSurface"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="TabItem:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="Expander.outputAdvanced:down">
      <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="ContentTransition" Value="{x:Null}" />
      <!-- Avalonia Simple's down-expander contract, kept flat and without a decorative container. -->
      <Setter Property="Template"><ControlTemplate><Grid RowDefinitions="Auto,Auto">
        <ToggleButton Name="PART_toggle" Classes="advanced" Content="{TemplateBinding Header}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
        <ContentPresenter Name="PART_ContentPresenter" Grid.Row="1" Margin="0,12,0,0" Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"
                          Foreground="{TemplateBinding Foreground}" IsVisible="{TemplateBinding IsExpanded}" Opacity="1" />
      </Grid></ControlTemplate></Setter>
    </Style>
    <Style Selector="ToggleButton.advanced">
      <Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource OutputMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid ColumnDefinitions="24,*"><Path Width="5" Height="8" Data="M 0 0 L 4 4 L 0 8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        </Grid>
      </Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ToggleButton.advanced:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="ToggleButton.advanced:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="ToggleButton.advanced:checked /template/ Path"><Setter Property="RenderTransform"><RotateTransform Angle="90" /></Setter></Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
      </Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource OutputHover}" /></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource OutputSelected}" /></Style>
    <Style Selector="ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource OutputFocus}" /></Style>
    <Style Selector="Separator"><Setter Property="Background" Value="{DynamicResource OutputBorder}" /><Setter Property="Margin" Value="0,4" /></Style>
    <StyleInclude Source="avares://Mmd.Modern.App/EditorPopupStyles.axaml" />
  
    <!-- MDA shared button roles (same in every window):
         default  = input surface + border; .primary = solid brand green; .quiet = flat (cancel/close). -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource MdaButton}" /><Setter Property="BorderBrush" Value="{DynamicResource MdaButtonBorder}" /><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource MdaButtonHover}" /></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource MdaButtonPressed}" /></Style>
    <Style Selector="Button:disabled"><Setter Property="Background" Value="{DynamicResource MdaButtonDisabled}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource MdaAccent}" /><Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.primary /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" /></Style>
    <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="{DynamicResource MdaAccentHover}" /></Style>
    <Style Selector="Button.primary:pressed"><Setter Property="Background" Value="{DynamicResource MdaAccent}" /></Style>
    <Style Selector="Button.primary:disabled"><Setter Property="Background" Value="{DynamicResource MdaButtonDisabled}" /></Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.quiet:pointerover"><Setter Property="Background" Value="{DynamicResource MdaButtonHover}" /></Style>
    <Style Selector="CheckBox:disabled"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource MdaAccentSoft}" /></Style>
    <Style Selector="TabItem:selected /template/ Border"><Setter Property="BorderBrush" Value="{DynamicResource MdaAccentSoft}" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource OutputInput}" Padding="20,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource Mda.Text.351e15538654}" Classes="section" />
        <TextBlock Grid.Column="1" Text="{Binding LightCountSummary}" Classes="caption" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="220,1,*">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,16,12,16">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource Mda.Text.0bb6877c08de}" Classes="caption" Margin="8,0" />
          <Grid ColumnDefinitions="*,4,*,4,*">
            <Button Content="{DynamicResource Mda.Text.03538630cc37}" Click="AddPoint" IsEnabled="{Binding CanAddLight}" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="action" AutomationProperties.Name="{DynamicResource Mda.Text.164901accbd4}" />
            <Button Grid.Column="2" Content="{DynamicResource Mda.Text.2c6e4ffdbe4d}" Click="AddSpot" IsEnabled="{Binding CanAddLight}" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="action" AutomationProperties.Name="{DynamicResource Mda.Text.5af0185beb3e}" />
            <Button Grid.Column="4" Content="{DynamicResource Mda.Text.f23a01a41c32}" Click="AddDirectional" IsEnabled="{Binding CanAddLight}" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="action" AutomationProperties.Name="{DynamicResource Mda.Text.dcf867d64ba7}" />
          </Grid>
          <Button Content="{DynamicResource Mda.Text.Context.Lighting.Area}" Click="AddArea" IsEnabled="{Binding CanAddLight}" Padding="6,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="action" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.Area}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,12">
          <ListBox Name="NativeLightsList" ItemsSource="{Binding Lights}" SelectedItem="{Binding SelectedLight, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" AutomationProperties.Name="{DynamicResource Mda.Text.58da4654116f}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="local:EditorNativeLightItem">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{DynamicResource Mda.Text.72716aafe6ba}" Classes="caption" Margin="8" IsVisible="{Binding !HasSelectedLight}" />
        </Grid>
        <Button Grid.Row="2" Content="{DynamicResource Mda.Text.42c4c5ec0f58}" Click="RemoveLight" IsEnabled="{Binding HasSelectedLight}" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Mda.Text.42c4c5ec0f58}" />
      </Grid>
      <Border Grid.Column="1" Background="{DynamicResource OutputBorder}" />
      <Grid Grid.Column="2">
        <TextBlock Text="{DynamicResource Mda.Text.23802db1ff96}" Classes="caption" Margin="24" IsVisible="{Binding !HasSelectedLight}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSelectedLight}">
          <!-- Keep all four possible forms alive so invalid text survives switching light rows. -->
          <ItemsControl ItemsSource="{Binding Lights}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:EditorNativeLightItem">
              <StackPanel Margin="24,20" Spacing="22" IsVisible="{Binding IsSelected}">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource Mda.Text.ca251de3d3f7}" Classes="section" />
                  <Grid ColumnDefinitions="94,*"><TextBlock Text="{DynamicResource Mda.Text.d44e9b3d3b31}" Classes="label" /><TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.7cb9050d7b72}" /></Grid>
                  <Grid ColumnDefinitions="94,*,100"><TextBlock Text="{DynamicResource Mda.Text.ba40014ff496}" Classes="label" /><ComboBox Grid.Column="1" ItemsSource="{Binding KindChoices}" SelectedIndex="{Binding KindIndex, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Mda.Text.0a10a5398b8a}"><ComboBox.ItemTemplate><DataTemplate x:DataType="local:EditorLightKindChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                  <Grid ColumnDefinitions="94,*,*"><CheckBox Grid.Column="1" Content="{DynamicResource Mda.Text.0d6601d54d15}" IsChecked="{Binding Enabled, Mode=TwoWay}" /><CheckBox Grid.Column="2" Content="{DynamicResource Mda.Text.eddb92cad478}" IsChecked="{Binding CastShadows, Mode=TwoWay}" /></Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding HasAreaSize}">
                    <TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.AreaDimensions}" Classes="section" />
                    <Grid ColumnDefinitions="94,*"><TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.AreaWidth}" Classes="label" /><validated:EditorNumericUpDown Grid.Column="1" Value="{Binding AreaWidth, Mode=TwoWay}" FormatString="0.####" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.AreaWidth}" /></Grid>
                    <Grid ColumnDefinitions="94,*"><TextBlock Text="{DynamicResource Mda.Text.Context.Lighting.AreaHeight}" Classes="label" /><validated:EditorNumericUpDown Grid.Column="1" Value="{Binding AreaHeight, Mode=TwoWay}" FormatString="0.####" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.Context.Lighting.AreaHeight}" /></Grid>
                  </StackPanel>
                </StackPanel>
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource Mda.Text.64412f9ebb77}" Classes="section" />
                  <Grid ColumnDefinitions="94,*,8,*,8,*" RowDefinitions="Auto,6,Auto,8,Auto">
                    <TextBlock Grid.Column="1" Text="X" Classes="caption" /><TextBlock Grid.Column="3" Text="Y" Classes="caption" /><TextBlock Grid.Column="5" Text="Z" Classes="caption" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource Mda.Text.1fb4d574da92}" Classes="label" />
                    <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding PositionX, Mode=TwoWay}" FormatString="0.####" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.c794c85eb233}" />
                    <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding PositionY, Mode=TwoWay}" FormatString="0.####" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.d231a265df1d}" />
                    <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="5" Value="{Binding PositionZ, Mode=TwoWay}" FormatString="0.####" Increment="0.1" AutomationProperties.Name="{DynamicResource Mda.Text.47f6738046c7}" />
                    <TextBlock Grid.Row="4" Text="{DynamicResource Mda.Text.bab4c7dc2948}" Classes="label" />
                    <validated:EditorNumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding RotationX, Mode=TwoWay}" IsEnabled="{Binding HasDirection}" FormatString="0.###" Increment="1" AutomationProperties.Name="{DynamicResource Mda.Text.fc879178fcc2}" />
                    <validated:EditorNumericUpDown Grid.Row="4" Grid.Column="3" Value="{Binding RotationY, Mode=TwoWay}" IsEnabled="{Binding HasDirection}" FormatString="0.###" Increment="1" AutomationProperties.Name="{DynamicResource Mda.Text.e4bf72774482}" />
                    <validated:EditorNumericUpDown Grid.Row="4" Grid.Column="5" Value="{Binding RotationZ, Mode=TwoWay}" IsEnabled="{Binding HasDirection}" FormatString="0.###" Increment="1" AutomationProperties.Name="{DynamicResource Mda.Text.69ba1a47f9f4}" />
                  </Grid>
                  <TextBlock Text="{DynamicResource Mda.Text.c6ec6ca85f6b}" Classes="caption" Margin="94,0,0,0" />
                </StackPanel>
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource Mda.Text.1f8c4657ed9c}" Classes="section" />
                  <Grid ColumnDefinitions="94,*,8,*,8,*" RowDefinitions="Auto,6,Auto,8,Auto,8,Auto">
                    <TextBlock Grid.Column="1" Text="R" Classes="caption" /><TextBlock Grid.Column="3" Text="G" Classes="caption" /><TextBlock Grid.Column="5" Text="B" Classes="caption" />
                    <TextBlock Grid.Row="2" Text="{DynamicResource Mda.Text.44ba8282f5e5}" Classes="label" />
                    <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Red, Mode=TwoWay}" FormatString="0.####" Increment="0.05" AutomationProperties.Name="{DynamicResource Mda.Text.8a05eccbaa40}" />
                    <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding Green, Mode=TwoWay}" FormatString="0.####" Increment="0.05" AutomationProperties.Name="{DynamicResource Mda.Text.5afec3ccb732}" />
                    <validated:EditorNumericUpDown Grid.Row="2" Grid.Column="5" Value="{Binding Blue, Mode=TwoWay}" FormatString="0.####" Increment="0.05" AutomationProperties.Name="{DynamicResource Mda.Text.32c648ad3cf5}" />
                    <TextBlock Grid.Row="4" Text="{DynamicResource Mda.Text.a2846644a638}" Classes="label" /><validated:EditorNumericUpDown Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Value="{Binding Intensity, Mode=TwoWay}" FormatString="0.####" Increment="0.25" AutomationProperties.Name="{DynamicResource Mda.Text.c56114268030}" />
                    <TextBlock Grid.Row="6" Text="{DynamicResource Mda.Text.3a76ebfb6233}" Classes="label" /><validated:EditorNumericUpDown Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Value="{Binding Range, Mode=TwoWay}" IsEnabled="{Binding HasRange}" FormatString="0.####" Increment="0.5" AutomationProperties.Name="{DynamicResource Mda.Text.0999a174c82d}" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="10" IsVisible="{Binding HasCone}">
                  <TextBlock Text="{DynamicResource Mda.Text.3466d127a0db}" Classes="section" />
                  <Grid ColumnDefinitions="94,*,16,94,*">
                    <TextBlock Text="{DynamicResource Mda.Text.aab9919ac9dc}" Classes="label" /><validated:EditorNumericUpDown Grid.Column="1" Value="{Binding InnerConeDegrees, Mode=TwoWay}" FormatString="0.###" Increment="1" AutomationProperties.Name="{DynamicResource Mda.Text.473225888625}" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource Mda.Text.08ba4adfa930}" Classes="label" /><validated:EditorNumericUpDown Grid.Column="4" Value="{Binding OuterConeDegrees, Mode=TwoWay}" FormatString="0.###" Increment="1" AutomationProperties.Name="{DynamicResource Mda.Text.bf2c5326647a}" />
                  </Grid>
                  <TextBlock Text="{DynamicResource Mda.Text.11012ed901f6}" Classes="caption" Margin="94,0,0,0" />
                </StackPanel>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource OutputBorder}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto,8,Auto">
        <StackPanel Spacing="3" Margin="0,0,20,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{DynamicResource Mda.Text.409713583939}" Classes="caption" />
        </StackPanel>
        <Button Classes="quiet" Grid.Column="1" Content="{DynamicResource Mda.Text.2cd0f3be8738}" Click="CancelLighting" MinWidth="76" AutomationProperties.Name="{DynamicResource Mda.Text.1927a05b954a}" />
        <Button Grid.Column="3" Name="ApplyLightingButton" Content="{DynamicResource Mda.Text.63c73c4730f4}" Classes="primary" Click="ApplyLighting" MinWidth="76" AutomationProperties.Name="{DynamicResource Mda.Text.5f3d6efa7e48}" />
      </Grid>
    </Border>
  </Grid>
</Window>
