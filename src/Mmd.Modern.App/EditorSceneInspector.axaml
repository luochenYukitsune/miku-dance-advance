<UserControl xmlns:validated="using:Mmd.Modern.App.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Mmd.Modern.App"
             x:Class="Mmd.Modern.App.EditorSceneInspector"
             x:DataType="local:EditorSceneInspectorViewModel">
  <StackPanel Spacing="16">
    <StackPanel Name="WorldInspector" Spacing="12" IsVisible="{Binding IsWorldInspector}">
      <Border Classes="parameterHeader"><TextBlock Text="{DynamicResource Mda.Text.33650a369521}" Classes="group" /></Border>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource Mda.Text.f4b669c55756}" Classes="muted" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="14" Background="White" BorderBrush="{DynamicResource EditorBorder}" BorderThickness="1" />
          <TextBlock Text="{DynamicResource Mda.Text.dd791232faa4}" />
        </StackPanel>
      </Grid>
      <Border Classes="parameterHeader"><TextBlock Text="{DynamicResource Mda.Text.870fef717617}" Classes="group" /></Border>
      <TextBlock Text="{DynamicResource Mda.Text.2f22e2a7b204}" />
    </StackPanel>
    <StackPanel Name="CameraInspector" Spacing="4" IsVisible="{Binding IsCameraInspector}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,2">
        <TextBlock Name="CameraPilotHintText" Text="{DynamicResource Mda.Text.CameraPilot.InspectorHint}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ToggleButton Name="CameraHelpersToggle" Grid.Column="1" Classes="guide" Height="24" MinHeight="22" Padding="7,0" IsChecked="True"
                      Content="{DynamicResource Mda.Text.CameraPilot.Helpers}" Click="ToggleCameraHelpersClicked"
                      ToolTip.Tip="{DynamicResource Mda.Text.CameraPilot.HelpersTip}"
                      AutomationProperties.Name="{DynamicResource Mda.Text.CameraPilot.Helpers}" />
        <ToggleButton Name="CameraInspectorPilotToggle" Grid.Column="2" Classes="guide" Height="24" MinHeight="22" Padding="8,0"
                      Content="{DynamicResource Mda.Text.CameraPilot.Enter}" Click="TogglePilotCameraClicked"
                      ToolTip.Tip="{DynamicResource Mda.Text.CameraPilot.Tooltip}" />
      </Grid>
      <Grid Name="CameraPoseGrid" ColumnDefinitions="5*,4*" RowDefinitions="Auto,Auto" ColumnSpacing="10" SizeChanged="ResizeCameraFields" IsEnabled="{Binding CanEdit}">
        <Grid Name="CameraTransformFields" ColumnDefinitions="Auto,*,*,*" RowDefinitions="16,28,28" ColumnSpacing="3" RowSpacing="2">
          <TextBlock Grid.Column="1" Text="X" Classes="axis" /><TextBlock Grid.Column="2" Text="Y" Classes="axis" /><TextBlock Grid.Column="3" Text="Z" Classes="axis" />
          <TextBlock Grid.Row="1" Text="{DynamicResource Mda.Text.707452e9a54a}" Classes="caption" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Text="{DynamicResource Mda.Text.68eb90fa809e}" Classes="caption" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Mda.Text.e24a9725df82}" />
          <validated:EditorNumericUpDown Name="CameraCenterX" Grid.Row="1" Grid.Column="1" Classes="editorNumber" Watermark="—" FormatString="0.000" Increment="0.1" Value="{Binding CameraCenterX, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.1eee91616d15}" />
          <validated:EditorNumericUpDown Name="CameraRotationX" Grid.Row="2" Grid.Column="1" Classes="editorNumber" Watermark="—" FormatString="0.0" Increment="1" Value="{Binding CameraRotationX, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.033d4b5dfa48}" />
          <validated:EditorNumericUpDown Name="CameraCenterY" Grid.Row="1" Grid.Column="2" Classes="editorNumber" Watermark="—" FormatString="0.000" Increment="0.1" Value="{Binding CameraCenterY, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.c70e68a78889}" />
          <validated:EditorNumericUpDown Name="CameraRotationY" Grid.Row="2" Grid.Column="2" Classes="editorNumber" Watermark="—" FormatString="0.0" Increment="1" Value="{Binding CameraRotationY, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.e5379ae54152}" />
          <validated:EditorNumericUpDown Name="CameraCenterZ" Grid.Row="1" Grid.Column="3" Classes="editorNumber" Watermark="—" FormatString="0.000" Increment="0.1" Value="{Binding CameraCenterZ, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.205d464f0bfc}" />
          <validated:EditorNumericUpDown Name="CameraRotationZ" Grid.Row="2" Grid.Column="3" Classes="editorNumber" Watermark="—" FormatString="0.0" Increment="1" Value="{Binding CameraRotationZ, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.1de96f3103eb}" />
        </Grid>
        <Grid Name="CameraLensFields" Grid.Column="1" RowDefinitions="16,28,28" ColumnSpacing="6" RowSpacing="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="130" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource Mda.Text.3865483de52d}" Classes="caption" />
          <TextBlock Grid.Column="1" Text="{DynamicResource Mda.Text.de32bdb05238}" Classes="caption" />
          <validated:EditorNumericUpDown Name="CameraDistance" Grid.Row="1" Classes="editorNumber" Watermark="—" FormatString="0.00" Increment="1" Value="{Binding CameraDistance, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.24a2c139c050}" />
          <validated:EditorNumericUpDown Name="CameraFov" validated:EditorNumberMenu.Draft="CameraFov" Grid.Row="1" Grid.Column="1" Classes="editorNumber" Watermark="—" Minimum="1" Maximum="179" Increment="1" FormatString="0.0" MenuDefaultValue="30" Value="{Binding CameraFov, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.28b9f9301519}" />
          <ComboBox Name="CameraProjection" Grid.Row="2" SelectedIndex="{Binding CameraProjectionIndex, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" MinWidth="0" ToolTip.Tip="{DynamicResource Mda.Text.caabf3ff858f}" AutomationProperties.Name="{DynamicResource Mda.Text.caabf3ff858f}">
            <ComboBoxItem Content="{DynamicResource Mda.Text.17e14283a497}" />
            <ComboBoxItem Content="{DynamicResource Mda.Text.3759f1efa160}" />
          </ComboBox>
          <validated:EditorValueSlider Name="CameraFovSlider" validated:EditorNumberMenu.Draft="CameraFov" Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="125" SmallChange="1" LargeChange="10" Step="0.5" DefaultValue="30"
                    Number="{Binding CameraFov, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Mda.Text.Slider.Hint}" AutomationProperties.Name="{DynamicResource Mda.Text.de32bdb05238}" />
        </Grid>
      </Grid>
      <TextBlock Text="{Binding CameraValidation}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasCameraValidation}" />
      <TextBlock Text="{Binding FrameSummary}" Classes="caption" IsVisible="{Binding HasCameraDraft}" />
      <StackPanel Name="CameraParentSummary" Spacing="6" IsVisible="{Binding HasCameraParent}">
        <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,Auto">
          <TextBlock Text="{DynamicResource Mda.Text.CameraParentObjectLabel}" Classes="caption" />
          <TextBlock Grid.Column="2" Text="{Binding CameraParentObject}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CameraParentObject}" />
          <TextBlock Grid.Row="1" Text="{DynamicResource Mda.Text.CameraParentBoneLabel}" Classes="caption" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CameraParentBone}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CameraParentBone}" />
        </Grid>
        <TextBlock Text="{Binding CameraParentHint}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
    <StackPanel IsVisible="{Binding ShowsPrimaryLightTrack}" Spacing="5">
      <TextBlock Text="{Binding LightKeyframeSummary}" Classes="caption" />
      <Button Classes="action" Content="{DynamicResource Mda.Text.e4b84a93325e}" Command="{Binding RegisterLightKeyframeCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </StackPanel>
</UserControl>
