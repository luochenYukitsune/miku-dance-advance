<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mmd.Modern.App.EditorRenderEngineSelectionWindow" x:ClassModifier="internal"
        Title="{DynamicResource Mda.Text.RenderEngineSelection.Title}"
        Width="600" Height="360" MinWidth="480" MinHeight="320"
        Icon="avares://Mmd.Modern.App/Assets/Branding/mda.ico"
        WindowStartupLocation="CenterOwner" CanMinimize="False" CanMaximize="False"
        Background="{DynamicResource SelectionSurface}" Foreground="{DynamicResource SelectionText}"
        FontFamily="avares://Mmd.Modern.App/Assets/Fonts#HarmonyOS Sans SC" FontSize="14"
        UseLayoutRounding="True" RenderOptions.TextRenderingMode="Antialias">
  <Window.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="SelectionFont">avares://Mmd.Modern.App/Assets/Fonts#HarmonyOS Sans SC</FontFamily>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SelectionSurface">#0F1216</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionText">#ECEFF2</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionMuted">#A4ACB6</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionDisabled">#69717B</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionBorder">#2B333D</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionHover">#222A34</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionSelected">#19302A</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionAccent">#3DD68C</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionInput">#1B2129</SolidColorBrush><SolidColorBrush x:Key="MdaAccent" Color="#2BB673" /><SolidColorBrush x:Key="MdaAccentText" Color="#06140C" /><SolidColorBrush x:Key="MdaAccentHover" Color="#35C77F" /><SolidColorBrush x:Key="MdaAccentSoft" Color="#3DD68C" /><SolidColorBrush x:Key="MdaAccentDisabled" Color="#1B2129" /><Color x:Key="SukiPrimaryColor">#2BB673</Color><SolidColorBrush x:Key="MdaButton" Color="#1F262F" /><SolidColorBrush x:Key="MdaButtonBorder" Color="#323C48" /><SolidColorBrush x:Key="MdaButtonHover" Color="#2A333E" /><SolidColorBrush x:Key="MdaButtonPressed" Color="#34404D" /><SolidColorBrush x:Key="MdaButtonDisabled" Color="#171C22" /><SolidColorBrush x:Key="EditorDisabledTextShared" Color="#69717B" /></ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SelectionSurface">#F6F7F9</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionText">#1A1D21</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionMuted">#5B636E</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionDisabled">#9AA1AA</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionBorder">#D9DEE5</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionHover">#E9EDF2</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionSelected">#DFF2E7</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionAccent">#12844A</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionInput">#EEF1F4</SolidColorBrush><SolidColorBrush x:Key="MdaAccent" Color="#12844A" /><SolidColorBrush x:Key="MdaAccentText" Color="#FFFFFF" /><SolidColorBrush x:Key="MdaAccentHover" Color="#0F7340" /><SolidColorBrush x:Key="MdaAccentSoft" Color="#12844A" /><SolidColorBrush x:Key="MdaAccentDisabled" Color="#EEF1F4" /><Color x:Key="SukiPrimaryColor">#12844A</Color><SolidColorBrush x:Key="MdaButton" Color="#F7F8FA" /><SolidColorBrush x:Key="MdaButtonBorder" Color="#CDD4DC" /><SolidColorBrush x:Key="MdaButtonHover" Color="#EEF1F4" /><SolidColorBrush x:Key="MdaButtonPressed" Color="#E3E8EE" /><SolidColorBrush x:Key="MdaButtonDisabled" Color="#EEF0F3" /><SolidColorBrush x:Key="EditorDisabledTextShared" Color="#9AA1AA" /></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://SukiUI/Theme/Index.xaml" />
    <Style Selector="TemplatedControl">
      <Setter Property="FontFamily" Value="{DynamicResource SelectionFont}" />
      <Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource SelectionText}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource SelectionFont}" />
      <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource SelectionText}" /><Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.engineName"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LineHeight" Value="22" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource SelectionMuted}" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="{DynamicResource SelectionMuted}" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /></Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource SelectionSurface}" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,10" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="MinHeight" Value="64" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource SelectionInput}" /><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch" />
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource SelectionHover}" /><Setter Property="BorderBrush" Value="{DynamicResource MdaButtonBorder}" /></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource SelectionSelected}" /><Setter Property="Foreground" Value="{DynamicResource SelectionText}" /><Setter Property="BorderBrush" Value="{DynamicResource SelectionAccent}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="ListBoxItem:selected:pointerover"><Setter Property="Background" Value="{DynamicResource SelectionSelected}" /><Setter Property="BorderBrush" Value="{DynamicResource SelectionAccent}" /></Style>
    <Style Selector="ListBoxItem:selected TextBlock.engineName"><Setter Property="Foreground" Value="{DynamicResource SelectionText}" /></Style>
    <Style Selector="ListBoxItem:selected TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource SelectionMuted}" /></Style>
    <Style Selector="ListBoxItem:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource SelectionText}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="ListBoxItem:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}" /></Style>
    <Style Selector="ListBoxItem:disabled TextBlock.engineName"><Setter Property="Foreground" Value="{DynamicResource SelectionMuted}" /></Style>
    <Style Selector="Button">
      <Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="4" /><Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
      <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions"><Transitions /></Setter>
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.action"><Setter Property="Background" Value="{DynamicResource SelectionInput}" /></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource SelectionHover}" /></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource SelectionSelected}" /></Style>
    <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource SelectionText}" /></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{DynamicResource SelectionDisabled}" /></Style>
  
    <!-- MDA shared button roles (same in every window):
         default  = input surface + border; .primary = solid brand green; .quiet = flat (cancel/close). -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button"><Setter Property="Background" Value="{DynamicResource MdaButton}" /><Setter Property="BorderBrush" Value="{DynamicResource MdaButtonBorder}" /><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource MdaButtonHover}" /></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource MdaButtonPressed}" /></Style>
    <Style Selector="Button:disabled"><Setter Property="Background" Value="{DynamicResource MdaButtonDisabled}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
    <Style Selector="Button.primary, Button[IsDefault=True]"><Setter Property="Background" Value="{DynamicResource MdaAccent}" /><Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.primary /template/ ContentPresenter, Button[IsDefault=True] /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" /></Style>
    <Style Selector="Button.primary TextBlock, Button[IsDefault=True] TextBlock"><Setter Property="Foreground" Value="{DynamicResource MdaAccentText}" /></Style>
    <Style Selector="Button.primary:pointerover, Button[IsDefault=True]:pointerover"><Setter Property="Background" Value="{DynamicResource MdaAccentHover}" /></Style>
    <Style Selector="Button.primary:pressed, Button[IsDefault=True]:pressed"><Setter Property="Background" Value="{DynamicResource MdaAccent}" /></Style>
    <Style Selector="Button.primary:focus-visible, Button[IsDefault=True]:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource SelectionText}" /></Style>
    <Style Selector="Button.primary:disabled, Button[IsDefault=True]:disabled"><Setter Property="Background" Value="{DynamicResource MdaButtonDisabled}" /></Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter, Button[IsDefault=True]:disabled /template/ ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
    <Style Selector="Button.primary:disabled TextBlock, Button[IsDefault=True]:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}" /></Style>
    <Style Selector="Button.quiet:pointerover"><Setter Property="Background" Value="{DynamicResource MdaButtonHover}" /><Setter Property="BorderBrush" Value="{DynamicResource MdaButtonBorder}" /></Style>
    <Style Selector="Button.quiet:pressed"><Setter Property="Background" Value="{DynamicResource MdaButtonPressed}" /><Setter Property="BorderBrush" Value="{DynamicResource MdaButtonBorder}" /></Style>
    <Style Selector="Button.quiet:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource SelectionText}" /></Style>
    <Style Selector="CheckBox:disabled"><Setter Property="Foreground" Value="{DynamicResource EditorDisabledTextShared}" /></Style>
    <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource MdaAccentSoft}" /></Style>
    <Style Selector="TabItem:selected /template/ Border"><Setter Property="BorderBrush" Value="{DynamicResource MdaAccentSoft}" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <TextBlock Name="RenderEngineSelectionPrompt" Text="{DynamicResource Mda.Text.RenderEngineSelection.Prompt}" Margin="0,0,0,14" />
    <Grid Grid.Row="1">
      <ListBox Name="RenderEngineChoices" SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="{DynamicResource Mda.Text.RenderEngineSelection.Title}" />
      <TextBlock Name="RenderEngineSelectionEmpty" Text="{DynamicResource Mda.Text.RenderEngineSelection.Empty}"
                 Classes="muted" IsVisible="False" Margin="12" />
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button Classes="quiet" Name="CancelRenderEngineButton" Content="{DynamicResource Mda.Text.RenderEngineSelection.Cancel}" MinWidth="80" IsCancel="True" Click="CancelSelection" />
      <Button Name="ConfirmRenderEngineButton" Content="{DynamicResource Mda.Text.RenderEngineSelection.Confirm}" MinWidth="104" IsDefault="True" Classes="primary" Click="ConfirmSelection" />
    </StackPanel>
  </Grid>
</Window>
