<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsTestProject>true</IsTestProject><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Mmd.Modern.Core/Mmd.Modern.Core.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.Animation/Mmd.Modern.Animation.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.Physics/Mmd.Modern.Physics.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.Effects/Mmd.Modern.Effects.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.Physics.Bepu/Mmd.Modern.Physics.Bepu.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.Physics.Bullet/Mmd.Modern.Physics.Bullet.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.Physics.Runtime/Mmd.Modern.Physics.Runtime.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.Rendering.D3D12/Mmd.Modern.Rendering.D3D12.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.ViewOutput.D3D12/Mmd.Modern.ViewOutput.D3D12.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.App/Mmd.Modern.App.csproj" />
    <ProjectReference Include="../../src/Mmd.Modern.Demo/Mmd.Modern.Demo.csproj" />
    <ProjectReference Include="../Mmd.Modern.PluginFixture/Mmd.Modern.PluginFixture.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <None Include="../../fixtures/humanoid.pmd" Link="fixtures/humanoid.pmd" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Mmd.Modern.Formats.Tests/Fixtures/rich-w1-uv4.pmx" Link="fixtures/rich-w1-uv4.pmx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Mmd.Modern.Application.Tests/Fixtures/pmm-v1-one-model.pmm" Link="fixtures/pmm-v1-one-model.pmm" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../src/Mmd.Modern.Smoke/SceneTextureLoader.cs" Link="Smoke/SceneTextureLoader.cs" />
  </ItemGroup>
  <ItemGroup>
    <_TestStylePlugin Include="../../src/Mda.StylePlugin.Genshin/Mda.StylePlugin.Genshin.csproj"
                      PluginId="mda.style.genshin"
                      ProjectName="Mda.StylePlugin.Genshin"
                      StageDir="plugins" />
    <_TestStylePlugin Include="../../src/Mda.StylePlugin.StarRail/Mda.StylePlugin.StarRail.csproj"
                      PluginId="mda.style.star-rail"
                      ProjectName="Mda.StylePlugin.StarRail"
                      StageDir="plugins" />
    <_TestStylePlugin Include="../../src/Mda.StylePlugin.WutheringWaves/Mda.StylePlugin.WutheringWaves.csproj"
                      PluginId="mda.style.wuthering-waves"
                      ProjectName="Mda.StylePlugin.WutheringWaves"
                      StageDir="plugins" />
    <_TestStylePlugin Include="../../src/Mda.StylePlugin.Endfield/Mda.StylePlugin.Endfield.csproj"
                      PluginId="mda.style.endfield"
                      ProjectName="Mda.StylePlugin.Endfield"
                      StageDir="plugins" />
    <_TestStylePlugin Include="../../examples/Mda.CustomStylePlugin/Mda.CustomStylePlugin.csproj"
                      PluginId="mda.style.custom-ink-cel"
                      ProjectName="Mda.CustomStylePlugin"
                      StageDir="ExampleStylePlugins" />
  </ItemGroup>
  <Target Name="_BuildStylePluginsForTests"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_PluginPlatformSegment Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'Any CPU'">$(Platform)/</_PluginPlatformSegment>
    </PropertyGroup>
    <ItemGroup>
      <_TestStylePluginToRestore Include="@(_TestStylePlugin)"
                                 Condition="!Exists('$(ModernCacheRoot)/obj/%(ProjectName)/project.assets.json')" />
    </ItemGroup>
    <MSBuild Condition="'@(_TestStylePluginToRestore)' != ''"
             Projects="@(_TestStylePluginToRestore)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ModernCacheRoot=$(ModernCacheRoot);RestoreLockedMode=true"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;PublishDir;OutDir;OutputPath;TargetDir"
             BuildInParallel="false" />
    <MSBuild Projects="@(_TestStylePlugin)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ModernCacheRoot=$(ModernCacheRoot)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile;PublishReadyToRun;PublishDir;OutDir;OutputPath;TargetDir"
             BuildInParallel="false" />
  </Target>
  <Target Name="CopyEditorPluginFixture" AfterTargets="Build" DependsOnTargets="_BuildStylePluginsForTests">
    <ItemGroup><EditorPluginFixtureFiles Include="$(ModernCacheRoot)/bin/Mmd.Modern.PluginFixture/$(Configuration)/$(TargetFramework)/*.dll;$(ModernCacheRoot)/bin/Mmd.Modern.PluginFixture/$(Configuration)/$(TargetFramework)/*.deps.json" /></ItemGroup>
    <Copy SourceFiles="@(EditorPluginFixtureFiles)" DestinationFolder="$(TargetDir)PluginFixtures" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ModernCacheRoot)/bin/%(_TestStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/%(_TestStylePlugin.ProjectName).dll;$(ModernCacheRoot)/bin/%(_TestStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/%(_TestStylePlugin.ProjectName).deps.json;$(ModernCacheRoot)/bin/%(_TestStylePlugin.ProjectName)/$(_PluginPlatformSegment)$(Configuration)/$(TargetFramework)/mda-plugin.json"
          DestinationFolder="$(TargetDir)%(_TestStylePlugin.StageDir)/%(_TestStylePlugin.PluginId)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_StrayTestPluginFiles Include="$(TargetDir)plugins/*/*.pdb;$(TargetDir)plugins/*/Mmd.Modern.Plugins.Contracts.dll;$(TargetDir)ExampleStylePlugins/*/*.pdb;$(TargetDir)ExampleStylePlugins/*/Mmd.Modern.Plugins.Contracts.dll" />
    </ItemGroup>
    <Delete Files="@(_StrayTestPluginFiles)" />
  </Target>
</Project>
