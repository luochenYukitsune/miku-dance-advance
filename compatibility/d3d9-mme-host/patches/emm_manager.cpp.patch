+void AddApplyDiagnostic(EmmApplyResult* result, EmmApplyPhase phase,
+                        EmmApplyFailure code, const std::string& section,
+                        const std::string& key, unsigned long long objectId,
+                        int subset, const std::string& detail)
+{
+    if (!result) return;
+    EmmApplyDiagnostic diagnostic;
+    diagnostic.phase = phase;
+    diagnostic.code = code;
+    diagnostic.sectionName = section;
+    diagnostic.key = key;
+    diagnostic.objectId = objectId;
+    diagnostic.subsetIndex = subset;
+    diagnostic.detail = detail;
+    result->diagnostics.push_back(std::move(diagnostic));
+}
