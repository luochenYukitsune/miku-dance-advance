+// The shared destructive tail of MmeEmmLoad. Only the legacy caller supplies
+// discovery; the mapped caller supplies a lookup into already frozen decisions.
+void ApplyParsedSections(const std::vector<EmmEffectSection>& sections,
+                         const std::map<std::string, ModelData*>& byKey,
+                         const std::function<std::string(ModelData*)>& rootSeed,
+                         std::vector<std::string>* assignedPaths,
+                         EmmApplyResult* result)
+{
+    for (const auto& section : sections) {
+        if (!section.isDefault()) continue;
+        MmeEmmSetDefaultEffect(section.defaultPath == kNone ? std::string() : section.defaultPath);
+        break;
+    }
+    if (result) result->mutated = true;
+    MmeContext* ctx = g_context;
+    if (!ctx) return;
+
+    // Replace every object's working map, including hidden and unmatched
+    // objects. Deleting every assignment also deletes its private overrides.
+    for (ModelData* model : ctx->models) {
+        if (!model) continue;
+        model->clearSubsetEffects();
+        MmeEmmClearSubsetShows(model);
+        model->resetShown();
+        ApplyEffectToModel(model, std::string());
+    }
+    if (result && g_ownerManager) {
+        g_ownerManager->turnOwners.clear();
+        g_ownerManager->planDirty = true;
+    }
+
+    std::map<ModelData*, std::string> basePaths;
+    std::map<ModelData*, std::string> objectKeys;
+    for (const auto& row : byKey) objectKeys[row.second] = row.first;
+    for (const auto& section : sections) {
+        if (!section.isDefault()) continue;
+        for (const auto& entry : section.entries) {
+            const auto object = byKey.find(entry.key);
+            if (object != byKey.end() && object->second && !entry.effectPath.empty())
+                basePaths[object->second] = entry.effectPath;
+        }
+    }
+    // Establish all roots before any subset or nested-owner compilation.
+    // A subset-only row leaves the root absent and therefore uses its seed.
+    for (ModelData* model : ctx->models) {
+        if (!model) continue;
+        const auto explicitRoot = basePaths.find(model);
+        std::string effectPath = explicitRoot == basePaths.end()
+            ? rootSeed(model) : explicitRoot->second;
+        if (effectPath == kNone) effectPath.clear();
+        ApplyEffectToModel(model, effectPath);
+        if (result && !effectPath.empty()) {
+            const auto* binding = FindBaseBinding(model, -1);
+            if (!binding || !binding->effect || binding->effectPath != effectPath)
+                AddApplyDiagnostic(result, EmmApplyPhase::Root, EmmApplyFailure::EffectBindingFailed,
+                    "Effect", objectKeys[model], model->objectId(), -1,
+                    "Root effect compilation or assignment-local instance creation failed");
+        }
+    }
+    if (result && !result->succeeded()) return;
+
+    for (const auto& section : sections) {
+        if (!section.isDefault()) continue;
+        for (const auto& entry : section.entries) {
+            const auto object = byKey.find(entry.key);
+            if (object == byKey.end() || !object->second) continue;
+            ModelData* model = object->second;
+            if (assignedPaths && !entry.effectPath.empty() && entry.effectPath != kNone)
+                assignedPaths->push_back(entry.effectPath);
+            if (entry.hasShow) model->setShown(entry.shown);
+            for (const auto& row : entry.subsetPaths) {
+                // The legacy loader historically records even an out-of-range
+                // effect row; mapped prevalidation rejects it before mutation.
+                ApplySubsetEffectToModel(model, row.first, row.second);
+                if (assignedPaths && !row.second.empty() && row.second != kNone)
+                    assignedPaths->push_back(row.second);
+                if (result && !row.second.empty() && row.second != kNone) {
+                    const auto* binding = FindBaseBinding(model, row.first);
+                    if (!binding || !binding->effect || binding->effectPath != row.second)
+                        AddApplyDiagnostic(result, EmmApplyPhase::Subset,
+                            EmmApplyFailure::EffectBindingFailed, section.name, entry.key,
+                            model->objectId(), row.first,
+                            "Subset effect compilation or assignment-local instance creation failed");
+                }
+            }
+            for (const auto& row : entry.subsetShows)
+                if (row.first >= 0 && row.first < model->materialCount())
+                    MmeEmmSetSubsetShown(model, row.first, row.second);
+        }
+    }
+    if (result && !result->succeeded()) return;
+    ApplyOwnerSections(sections, byKey, result);
 }
 
