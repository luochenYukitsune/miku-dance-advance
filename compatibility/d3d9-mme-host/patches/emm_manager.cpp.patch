+EmmApplyResult MmeEmmApplyMapped(
+    const std::vector<EmmEffectSection>& sections,
+    const std::map<std::string, EmmMappedObject>& objects,
+    const std::map<unsigned long long, EmmRootSeed>& rootSeeds)
+{
+    EmmApplyResult result;
+    // The transport uses 1=model/2=accessory; OnCreateModel and ModelData retain
+    // the original MME ABI's 1=model/0=accessory. Reject every other pairing.
+    const auto kindMatches = [](int transportKind, int hostKind) {
+        return (transportKind == 1 && hostKind == 1) ||
+               (transportKind == 2 && hostKind == 0);
+    };
+    const auto fail = [&](EmmApplyFailure code, const std::string& section,
+                          const std::string& key, unsigned long long id,
+                          int subset, const std::string& detail) {
+        AddApplyDiagnostic(&result, EmmApplyPhase::Validation, code,
+                           section, key, id, subset, detail);
+    };
+    MmeContext* ctx = g_context;
+    if (!ctx) {
+        fail(EmmApplyFailure::NoContext, "", "", 0, -1, "No current MME context");
+        return result;
+    }
+    if (!g_ownerManager) {
+        fail(EmmApplyFailure::NoOwnerManager, "", "", 0, -1, "No current assignment owner manager");
+        return result;
+    }
+
+    // Never retain any of these pointers in the logical configuration. The
+    // host may have replaced the geometry and ModelData since the last call.
+    std::map<unsigned long long, ModelData*> live;
+    for (ModelData* model : ctx->models) {
+        if (!model) continue;
+        const auto id = model->objectId();
+        const auto current = ctx->modelRegistry.find(id);
+        if (!id || current == ctx->modelRegistry.end() || current->second != model) {
+            fail(EmmApplyFailure::UnknownObject, "", "", id, -1,
+                 "Live object is not the current registry object");
+            continue;
+        }
+        if (!live.emplace(id, model).second)
+            fail(EmmApplyFailure::DuplicateObject, "", "", id, -1,
+                 "Live object identity occurs more than once");
+    }
+    for (const auto& row : ctx->modelRegistry) {
+        if (row.second && live.find(row.first) == live.end())
+            fail(EmmApplyFailure::UnknownObject, "", "", row.first, -1,
+                 "Current registry object is absent from the live object list");
+    }
+
+    std::map<std::string, ModelData*> byKey;
+    std::set<unsigned long long> mappedIds;
+    for (const auto& row : objects) {
+        const auto id = row.second.objectId;
+        const auto current = live.find(id);
+        if (!id || (row.second.kind != 1 && row.second.kind != 2)) {
+            fail(EmmApplyFailure::InvalidIdentity, "", row.first, id, -1,
+                 "Mapped identity must be nonzero and kind must be 1 or 2");
+            continue;
+        }
+        if (current == live.end()) {
+            fail(EmmApplyFailure::UnknownObject, "", row.first, id, -1,
+                 "Mapped identity is absent from the current registry");
+            continue;
+        }
+        const bool keyKindMatches = row.second.kind == 1
+            ? row.first.compare(0, 3, "Pmd") == 0 : row.first.compare(0, 3, "Acs") == 0;
+        if (!kindMatches(row.second.kind, current->second->kind()) || !keyKindMatches) {
+            fail(EmmApplyFailure::KindMismatch, "", row.first, id, -1,
+                 "Record key, declared kind and current object kind disagree");
+            continue;
+        }
+        if (!mappedIds.insert(id).second) {
+            fail(EmmApplyFailure::DuplicateObject, "", row.first, id, -1,
+                 "Two record keys map to the same live object");
+            continue;
+        }
+        byKey.emplace(row.first, current->second);
+    }
+    for (const auto& row : live) {
+        const auto seed = rootSeeds.find(row.first);
+        if (seed == rootSeeds.end()) {
+            fail(EmmApplyFailure::MissingRootSeed, "Effect", "", row.first, -1,
+                 "Every live object requires a frozen root decision");
+        } else if ((seed->second.kind != 1 && seed->second.kind != 2) ||
+                   !kindMatches(seed->second.kind, row.second->kind())) {
+            fail(EmmApplyFailure::KindMismatch, "Effect", "", row.first, -1,
+                 "Frozen root kind disagrees with current object kind");
+        }
+    }
+    for (const auto& seed : rootSeeds) {
+        if (!seed.first || live.find(seed.first) == live.end())
+            fail(EmmApplyFailure::UnknownObject, "Effect", "", seed.first, -1,
+                 "Frozen root identity is absent from the current registry");
+    }
+
+    std::map<std::string, const EmmEffectSection*> labels;
+    unsigned defaultCount = 0;
+    for (const auto& section : sections) {
+        if (section.isDefault()) {
+            ++defaultCount;
+            if (section.name != "Effect" || section.defaultPath.empty())
+                fail(EmmApplyFailure::InvalidSection, section.name, "", 0, -1,
+                     "Default section must be Effect and have a Default row");
+        } else {
+            if (section.name.compare(0, 7, "Effect@") != 0 || section.name.size() == 7) {
+                fail(EmmApplyFailure::InvalidSection, section.name, section.ownerKey, 0,
+                     section.ownerSubsetIndex, "Named section has no Effect@ label");
+            } else if (!labels.emplace(section.name.substr(7), &section).second) {
+                fail(EmmApplyFailure::DuplicateSection, section.name, section.ownerKey, 0,
+                     section.ownerSubsetIndex, "Named section label occurs more than once");
+            }
+            const auto owner = byKey.find(section.ownerKey);
+            if (owner == byKey.end()) {
+                fail(EmmApplyFailure::UnknownOwner, section.name, section.ownerKey, 0,
+                     section.ownerSubsetIndex, "Owner record key has no current mapped object");
+            } else if (section.ownerSubsetIndex < -1 ||
+                       section.ownerSubsetIndex >= owner->second->materialCount()) {
+                fail(EmmApplyFailure::InvalidSubset, section.name, section.ownerKey,
+                     owner->second->objectId(), section.ownerSubsetIndex,
+                     "Owner subset is outside the actual current material table");
+            }
+        }
+        for (const auto& entry : section.entries) {
+            const auto object = byKey.find(entry.key);
+            if (object == byKey.end()) {
+                fail(EmmApplyFailure::UnknownKey, section.name, entry.key, 0, -1,
+                     "Assignment record key has no current mapped object");
+                continue;
+            }
+            const auto validateSubset = [&](int subset) {
+                if (subset < 0 || subset >= object->second->materialCount())
+                    fail(EmmApplyFailure::InvalidSubset, section.name, entry.key,
+                         object->second->objectId(), subset,
+                         "Assignment subset is outside the actual current material table");
+            };
+            for (const auto& row : entry.subsetPaths) validateSubset(row.first);
+            for (const auto& row : entry.subsetShows) validateSubset(row.first);
+        }
+    }
+    if (defaultCount != 1)
+        fail(EmmApplyFailure::InvalidSection, "Effect", "", 0, -1,
+             "Exactly one default Effect section is required");
+
+    // Parent labels are the exact saved label, including a possible suffix.
+    // This validates topology without constructing or retaining native turns.
+    for (const auto& label : labels) {
+        const auto* section = label.second;
+        if (!section->ownerMaterialName.empty() &&
+            labels.find(section->ownerMaterialName) == labels.end()) {
+            fail(EmmApplyFailure::UnknownParent, section->name, section->ownerKey, 0,
+                 section->ownerSubsetIndex, "Owner parent label is absent from this configuration");
+        }
+    }
+    // Each label has one parent. Memoize completed chains so a valid long
+    // chain is visited once, rather than once per descendant (quadratic).
+    // Keep this iterative: accepted packages may contain tens of thousands
+    // of labels, too many for a recursive DFS on the render-owner stack.
+    std::map<std::string, unsigned char> colors;
+    for (const auto& label : labels) {
+        if (colors[label.first] == 2) continue;
+        std::vector<std::string> chain;
+        auto cursor = labels.find(label.first);
+        for (;;) {
+            auto& color = colors[cursor->first];
+            if (color == 2) break;
+            if (color == 1) {
+                const auto* section = cursor->second;
+                fail(EmmApplyFailure::OwnerCycle, section->name, section->ownerKey, 0,
+                     section->ownerSubsetIndex, "Owner parent chain contains a cycle");
+                break;
+            }
+            color = 1;
+            chain.push_back(cursor->first);
+            const auto& parent = cursor->second->ownerMaterialName;
+            if (parent.empty()) break;
+            const auto next = labels.find(parent);
+            if (next == labels.end()) break;
+            cursor = next;
+        }
+        for (const auto& key : chain) colors[key] = 2;
+    }
+    if (!result.succeeded()) return result;
+
+    ApplyParsedSections(sections, byKey, [&](ModelData* model) {
+        return rootSeeds.find(model->objectId())->second.effectPath;
+    }, nullptr, &result);
+    return result;
+}
