+// Exact map lookup avoids an active offscreen turn's MmeFindMaterialBinding
+// shortcut when verifying a newly applied base assignment.
+MaterialBinding* FindBaseBinding(ModelData* model, int subset)
+{
+    if (!g_ownerManager) return nullptr;
+    const auto it = g_ownerManager->bindings.find({0, model, subset});
+    return it == g_ownerManager->bindings.end() ? nullptr : it->second;
+}
