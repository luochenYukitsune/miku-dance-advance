+static bool SasResolveResourcePath(SasEffect* sas, const std::string& requested,
+                                   std::string& result) {
+    result.clear();
+    if (MdaMmeMappedResourcesV1()) {
+        std::string error;
+        if (!MdaMappedResourcePath(sas->path, requested, result, error)) {
+            SasLogFormat(sas, "Error: %s\n", error.c_str());
+            return false;
+        }
+        if (GetFileAttributesA(result.c_str()) != INVALID_FILE_ATTRIBUTES) return true;
+        result.clear();
+        return false;
+    }
+    char absolute[MAX_PATH] = { 0 };
+    if (_fullpath(absolute, requested.c_str(), sizeof(absolute)) != nullptr &&
+        GetFileAttributesA(absolute) != INVALID_FILE_ATTRIBUTES) {
+        result = absolute;
+        return true;
+    }
+    return false;
