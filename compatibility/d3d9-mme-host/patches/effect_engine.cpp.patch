+void MmeEngineClearLostDeviceCaches()
+{
+    // The owning device thread calls this only after MmeEngineOnLostDevice
+    // has returned. Its temporary LiveEffects() strong references are gone;
+    // no concurrent binding resolution can change ownership during this walk.
+    // Keep sources still owned by live bindings/assignment instances under
+    // their existing cache keys. Replacing those sources on the first frame
+    // would replace the bindings and lose authored offscreen overrides.
+    auto& effects = EffectCacheRef();
+    for (auto it = effects.begin(); it != effects.end();) {
+        if (!it->second || it->second.use_count() == 1) {
+            it = effects.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    // DEFAULT resources and stateblocks were already released by the lost
+    // walk; preserving logical effect identity does not reacquire them.
+    TextureCacheRef().clear();
+}
