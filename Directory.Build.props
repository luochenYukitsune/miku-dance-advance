<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ModernCacheRoot Condition="'$(ModernCacheRoot)' == ''">$(MSBuildThisFileDirectory)../.dev-cache/modern-dotnet</ModernCacheRoot>
    <BaseIntermediateOutputPath>$(ModernCacheRoot)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(ModernCacheRoot)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
  </PropertyGroup>
</Project>
